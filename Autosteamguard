                f"❌ Неверный формат файла: {file_name}\nНужен файл .maFile"
            )
            return

        cardinal.telegram.bot.send_message(message.chat.id, "⏳ Сохранение аккаунта...")

        file_info = cardinal.telegram.bot.get_file(message.document.file_id)
        downloaded_file = cardinal.telegram.bot.download_file(file_info.file_path)

        mafile_path = os.path.join(MAFILES_DIR, file_name)
        if os.path.exists(mafile_path):
            os.remove(mafile_path)

        with open(mafile_path, "wb") as f:
            f.write(downloaded_file)

        try:
            with open(mafile_path, "r") as f:
                mafile_data = json.load(f)
            required_fields = ["shared_secret", "identity_secret", "device_id", "Session", "account_name"]
            missing_fields = [field for field in required_fields if field not in mafile_data]
            if missing_fields:
                os.remove(mafile_path)
                cardinal.telegram.bot.send_message(
                    message.chat.id,
                    f"❌ Неверный формат .maFile!\nОтсутствуют поля: {', '.join(missing_fields)}"
                )
                return
        except json.JSONDecodeError:
            os.remove(mafile_path)
            cardinal.telegram.bot.send_message(message.chat.id, "❌ Файл повреждён или неверный формат JSON.")
            return

        account_name = mafile_data.get("account_name", login)
        default_duration = 24

        success = db.add_account(
            account_name=account_name,
            path_to_maFile=mafile_path,
            login=login,
            password=password,
            duration=default_duration,
            game_type_id=game_type_id
        )

        if success:
            cardinal.telegram.bot.send_message(
                message.chat.id,
                f"✅ <b>Аккаунт успешно добавлен!</b>\n\n"
                f"🎮 Тип игры: <code>{game_type_name}</code>\n"
                f"🔐 Логин: <code>{login}</code>\n"
                f"🔑 Пароль: <code>{password}</code>\n"
                f"📁 .maFile: <code>{file_name}</code>\n\n"
                f"💡 Срок аренды задаётся при привязке лота\n\n"
                f"Аккаунт готов к аренде! 🎮",
                parse_mode='HTML'
            )
            logger.info(f"[STEAM ADD] ✅ Аккаунт {login} добавлен")

            update_lot_states(cardinal)
        else:
            cardinal.telegram.bot.send_message(message.chat.id, "❌ Ошибка при добавлении аккаунта в БД.")

    except Exception as e:
        logger.error(f"[STEAM ADD] Ошибка: {e}", exc_info=True)
        cardinal.telegram.bot.send_message(message.chat.id, f"❌ Ошибка: {str(e)}")


