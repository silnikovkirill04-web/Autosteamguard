def update_lot_states(cardinal: Cardinal):
    global lot_states

    if not config.get("auto_lot_management", True):
        return

    if db is None:
        return

    try:
        all_lots = db.get_lots_with_game_type_ids()

        if not all_lots:
            return

        lots_by_game_type: Dict[int, List[Dict]] = {}
        for lot in all_lots:
            gt_id = lot["game_type_id"]
            if gt_id not in lots_by_game_type:
                lots_by_game_type[gt_id] = []
            lots_by_game_type[gt_id].append(lot)

        for game_type_id, lots in lots_by_game_type.items():
            free_count = db.count_unowned_by_game_type(game_type_id)
            should_be_active = free_count > 0

            for lot in lots:
                lot_id = lot.get("lot_id")
                if not lot_id:
                    continue

                current_state = lot_states.get(lot_id, True)

                if should_be_active and not current_state:
                    _enable_lot(cardinal, lot_id, lot["lot_name"])
                    lot_states[lot_id] = True
                    logger.info(f"[STEAM LOTS] ✅ Лот '{lot['lot_name']}' (ID: {lot_id}) ВКЛЮЧЕН - появились аккаунты")

                elif not should_be_active and current_state:
                    _disable_lot(cardinal, lot_id, lot["lot_name"])
                    lot_states[lot_id] = False
                    logger.info(f"[STEAM LOTS] ❌ Лот '{lot['lot_name']}' (ID: {lot_id}) ВЫКЛЮЧЕН - нет аккаунтов")

    except Exception as e:
        logger.error(f"[STEAM LOTS] Ошибка обновления состояния лотов: {e}", exc_info=True)


def _enable_lot(cardinal: Cardinal, lot_id: str, lot_name: str):
