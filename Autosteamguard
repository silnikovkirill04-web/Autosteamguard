def handle_change_limit(message):
    """Обрабатывает ввод лимита"""
    try:
        new_limit = float(message.text.strip())
        if new_limit >= 0:
            SETTINGS["max_refund_price"] = new_limit
            save_config()
            bot.reply_to(message, f"✅ Лимит возврата установлен: {new_limit}₽")
        else:
            bot.reply_to(message, "❌ Введите положительное число!")
    except ValueError:
        bot.reply_to(message, "❌ Введите число!")
    
    tg.clear_state(message.chat.id, message.from_user.id)
    show_menu(message)

