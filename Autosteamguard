def check_schedule():
    """Проверяет шаблоны по расписанию"""
    templates = SETTINGS.get("templates", {})
    current_time = get_current_time()
    current_day = get_day_name()
    
    for template_id, template in templates.items():
        try:
            if not template.get("active", True):
                continue
            
            if template.get("time") != current_time:
                continue
            
            days = template.get("days", [])
            if days and current_day not in days:
                continue
            
            last_sent = template.get("last_sent")
            if last_sent:
                last_date = datetime.fromisoformat(last_sent)
                if last_date.date() == datetime.now().date():
                    continue
            
            # 🔥 ОТПРАВЛЯЕМ ШАБЛОН
            message_text = template.get("message", "")
            if not message_text:
                continue
            
            message_text = format_text_with_variables(message_text)
            
            # Получаем все чаты
            chats = cardinal.account.get_chats()
            if chats:
                for chat in chats:
                    try:
                        # Не отправляем в заказы
                        if getattr(chat, 'node_id', None):
                            continue
                        cardinal.send_message(chat.id, message_text)
                        time.sleep(0.5)
                    except Exception as e:
                        logger.error(f"❌ Ошибка отправки в чат {chat.id}: {e}")
            
            template["last_sent"] = datetime.now().isoformat()
            save_config()
            
            logger.info(f"📤 Отправлен шаблон '{template.get('name', 'Без имени')}'")
            
        except Exception as e:
            logger.error(f"❌ Ошибка шаблона {template_id}: {e}")

def schedule_worker():
    """Фоновый поток для проверки расписания"""
    while True:
        try:
            if SETTINGS.get("active", True) and SETTINGS.get("auto_reply_enabled", True):
                check_schedule()
            time.sleep(30)
        except Exception as e:
            logger.error(f"❌ Ошибка в планировщике: {e}")
            time.sleep(60)

