def init_plugin(c):
    global cardinal, tg, bot
    cardinal = c
    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[BRR] 💰 ЗАГРУЗКА Bad Review Refund v1.4")
    print("[BRR] 🔄 Парсинг системных сообщений")
    print(f"[BRR] 💰 Макс. сумма возврата: {SETTINGS.get('max_refund_price', 10)}₽")
    print("=" * 50)
    
    load_config()
    
    # Регистрация команд
    c.add_telegram_commands(UUID, [("brr", "💰 Возврат по отзывам", True)])
    tg.msg_handler(show_menu, commands=["brr"])
    
    # Обработчик ввода лимита
    tg.msg_handler(handle_change_limit, func=lambda m: tg.check_state(m.chat.id, m.from_user.id, "brr_change_limit"))
    
    # 🔥 РЕГИСТРАЦИЯ КОЛБЭКОВ
    def toggle_cb(call):
        SETTINGS["active"] = not SETTINGS.get("active", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['active'] else 'OFF'}")
        show_menu(call.message)
        # Перезапускаем проверщик
        if SETTINGS["active"]:
            start_checker()
        else:
            stop_checker_thread()
    
    def refund_toggle_cb(call):
        SETTINGS["refund_enabled"] = not SETTINGS.get("refund_enabled", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['refund_enabled'] else 'OFF'}")
        show_menu(call.message)
    
    def refresh_cb(call):
        bot.answer_callback_query(call.id, "🔄 Обновлено")
        show_menu(call.message)
    
    def change_limit_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "💰 Введите новую максимальную сумму для возврата (например: 10, 50, 100):")
        # 🔥 ИСПРАВЛЕНО: 3 аргумента, без msg.id
        tg.set_state(call.message.chat.id, call.from_user.id, "brr_change_limit")
    
    # Регистрируем через tg.cbq_handler
    tg.cbq_handler(toggle_cb, lambda call: call.data == "brr_toggle")
    tg.cbq_handler(refund_toggle_cb, lambda call: call.data == "brr_refund_toggle")
    tg.cbq_handler(refresh_cb, lambda call: call.data == "brr_refresh")
    tg.cbq_handler(change_limit_cb, lambda call: call.data == "brr_change_limit")
    
    # 🔥 ЗАПУСКАЕМ ФОНОВЫЙ ПОТОК
    if SETTINGS.get("active", True):
        start_checker()
    
    print("[BRR] ✅ Плагин загружен!")
    print("[BRR] 📌 /brr — меню настроек")
    print("=" * 50)

