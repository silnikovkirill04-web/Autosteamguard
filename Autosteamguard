def review_handler(e):
    """Обрабатывает новые отзывы и делает возврат"""
    
    logger.info("🔔 Получено событие отзыва")
    
    if not SETTINGS.get("active", True):
        logger.info("⏸️ Плагин отключен")
        return
    
    if not SETTINGS.get("refund_enabled", True):
        logger.info("⏸️ Возвраты отключены")
        return
    
    try:
        # Получаем отзыв
        review = getattr(e, 'review', None)
        if not review:
            logger.warning("⚠️ Отзыв не найден в событии")
            return
        
        # Получаем данные из отзыва
        review_text = getattr(review, 'text', '') or ''
        review_stars = getattr(review, 'stars', 0)
        order_id = get_order_id_from_review(review)
        
        chat_id = getattr(e, 'chat_id', None)
        if not chat_id:
            chat_id = getattr(review, 'chat_id', None)
        
        logger.info(f"📋 Данные отзыва:")
        logger.info(f"   Текст: {review_text[:50]}..." if review_text else "   Текст: (пусто)")
        logger.info(f"   Звёзды: {review_stars}")
        logger.info(f"   Заказ: {order_id}")
        logger.info(f"   Чат: {chat_id}")
        
        # Проверяем, не обрабатывали ли уже этот заказ
        if order_id and order_id in processed_orders:
            elapsed = time.time() - processed_orders[order_id]
            if elapsed < 3600:
                logger.info(f"⏸️ Заказ {order_id} уже обработан {int(elapsed)}с назад, пропускаем")
                return
        
        # Проверяем сумму заказа (если есть order_id)
        if order_id:
            try:
                order = cardinal.account.get_order(order_id)
                if order:
                    order_price = get_order_price(order)
                    max_price = SETTINGS.get("max_refund_price", 10)
                    
                    if order_price > max_price:
                        logger.info(f"❌ Сумма заказа {order_price}₽ > {max_price}₽ → возврат НЕ ДЕЛАЕТСЯ")
                        if chat_id:
                            cardinal.send_message(chat_id, f"ℹ️ Возврат не выполнен (сумма заказа {order_price}₽ превышает лимит {max_price}₽)")
                        return
            except Exception as e:
                logger.warning(f"⚠️ Не удалось проверить сумму заказа: {e}")
        
        # ГЛАВНАЯ ЛОГИКА
        is_bad = False
        reason = ""
        
        if review_stars <= 4:
            is_bad = True
            reason = f"низкая оценка ({review_stars} звезд)"
            logger.info(f"⭐ {review_stars} звезд → возврат сразу (без проверки слов)")
        else:
            # 5 звезд → проверяем слова
            if review_text and check_bad_review(review_text):
                is_bad = True
                reason = "плохие слова в отзыве (5 звезд)"
                logger.info(f"⭐ 5 звезд, но найдены плохие слова → возврат")
            else:
                logger.info(f"⭐ 5 звезд, плохих слов нет → возврат НЕ требуется")
        
        if not is_bad:
            return
        
        if order_id:
            processed_orders[order_id] = time.time()
            logger.info(f"📝 Заказ {order_id} добавлен в историю")
        
        # Делаем возврат
        if order_id and chat_id:
            logger.info(f"🔄 Запуск возврата по заказу {order_id} (причина: {reason})...")
            refund_order(chat_id, order_id, review_text, review_stars, reason)
        else:
            logger.error(f"❌ Не хватает данных для возврата: order_id={order_id}, chat_id={chat_id}")
        
        # Очищаем старые записи
        now = time.time()
        for oid in list(processed_orders.keys()):
            if now - processed_orders[oid] > 86400:
                del processed_orders[oid]
        
    except Exception as e:
        logger.error(f"❌ ОШИБКА обработки отзыва: {e}")
        import traceback
        traceback.print_exc()

