def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def check_bad_review(text):
    """Проверяет текст на наличие негативных слов"""
    if not text:
        return False
    
    text_lower = text.lower()
    
    for word in SETTINGS.get("bad_words", []):
        # Ищем слово как отдельное (не в составе других слов)
        pattern = r'\b' + re.escape(word.lower()) + r'\b'
        if re.search(pattern, text_lower):
            return True
    
    return False

def parse_review_from_system_message(text):
    """
    Парсит системное сообщение об отзыве
    Пример: "Покупатель <Имя> оставил отзыв: (5 звезд) Текст отзыва"
    """
    if not text:
        return None, None
    
    # 🔥 Парсим звёзды
    stars_match = re.search(r'\((\d+)\s*звезд', text)
    stars = int(stars_match.group(1)) if stars_match else 0
    
    # 🔥 Парсим текст отзыва (после ": ")
    text_match = re.search(r':\s*(.+)$', text)
    review_text = text_match.group(1) if text_match else ""
    
    return stars, review_text

def get_order_price(order):
    """Получает сумму заказа"""
    try:
        if hasattr(order, 'price'):
            return float(order.price)
        elif hasattr(order, 'amount'):
            return float(order.amount)
        else:
            return 0
    except:
        return 0

def make_refund(order, chat_id):
    """Делает возврат по заказу"""
    try:
        # 🔥 ИСПРАВЛЕНО: передаём ОБЪЕКТ ЗАКАЗА, а не ID
        cardinal.account.refund(order)
        logger.info(f"✅ Возврат по заказу {order.id} выполнен!")
        return True
    except Exception as e:
        logger.error(f"❌ Ошибка возврата: {e}")
        return False

