def show_words(message):
    words = SETTINGS.get("bad_words", [])
    
    if not words:
        text = "📝 Список плохих слов пуст"
    else:
        text = "📝 **Список плохих слов:**\n\n"
        for i, word in enumerate(words, 1):
            text += f"{i}. `{word}`\n"
    
    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("◀️ Назад", callback_data="brr_menu"))
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

