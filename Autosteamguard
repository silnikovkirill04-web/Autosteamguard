# ============================================
# 🔧 СЛУЖЕБНЫЕ ФУНКЦИИ
# ============================================

def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        print(f"[BRR] ❌ Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        print(f"[BRR] ❌ Ошибка сохранения: {e}")

def check_bad_review(text):
    """Проверяет текст на наличие негативных слов"""
    if not text:
        return False
    
    text_lower = text.lower()
    
    for word in SETTINGS.get("bad_words", []):
        if word.lower() in text_lower:
            return True
        
        word_no_spaces = word.replace(" ", "")
        if word_no_spaces and word_no_spaces in text_lower.replace(" ", ""):
            return True
    
    return False

def refund_order(chat_id, order_id, review_text, review_stars):
    """Делает возврат по заказу с подробным логированием"""
    print(f"[BRR] 🔄 Начинаю возврат по заказу {order_id}")
    
    try:
        # 🔥 ПРОВЕРЯЕМ ПОЛУЧЕНИЕ ЗАКАЗА
        print(f"[BRR] 📦 Получаю заказ {order_id}...")
        order = cardinal.account.get_order(order_id)
        
        if not order:
            print(f"[BRR] ❌ Заказ {order_id} НЕ НАЙДЕН!")
            return False
        
        print(f"[BRR] ✅ Заказ найден: {order}")
        
        # 🔥 ПРОВЕРЯЕМ ВОЗМОЖНОСТЬ ВОЗВРАТА
        print(f"[BRR] 🔍 Проверяю возможность возврата...")
        
        if not hasattr(order, 'can_refund'):
            print(f"[BRR] ❌ У заказа нет метода can_refund()")
            return False
        
        if not order.can_refund():
            print(f"[BRR] ❌ Возврат по заказу {order_id} НЕВОЗМОЖЕН!")
            print(f"[BRR] 💡 Возможно: заказ уже завершен или прошло слишком много времени")
            return False
        
        print(f"[BRR] ✅ Возврат возможен")
        
        # 🔥 ДЕЛАЕМ ВОЗВРАТ
        print(f"[BRR] 💰 Выполняю возврат...")
        
        if not hasattr(order, 'refund'):
            print(f"[BRR] ❌ У заказа нет метода refund()")
            return False
        
        order.refund()
        
        print(f"[BRR] ✅ Возврат по заказу {order_id} ВЫПОЛНЕН!")
        
        # 🔥 ОТПРАВЛЯЕМ СООБЩЕНИЕ
        refund_msg = SETTINGS.get("refund_message", "✅ Возврат выполнен. Извините за неудобства!")
        cardinal.send_message(chat_id, refund_msg)
        print(f"[BRR] 📤 Отправлено сообщение покупателю: {refund_msg}")
        
        # 🔥 УВЕДОМЛЕНИЕ АДМИНУ
        if SETTINGS.get("admin_notify", True):
            admin_msg = (
                f"💰 **Возврат выполнен!**\n\n"
                f"🆔 Заказ: {order_id}\n"
                f"💬 Отзыв: {review_text[:100]}...\n"
                f"⭐ Оценка: {review_stars} звезд\n"
                f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
            )
            admin_id = SETTINGS.get("admin_chat_id")
            if admin_id:
                cardinal.send_message(admin_id, admin_msg)
                print(f"[BRR] 📤 Отправлено уведомление админу")
        
        return True
        
    except Exception as e:
        print(f"[BRR] ❌ ОШИБКА возврата по заказу {order_id}: {e}")
        import traceback
        traceback.print_exc()
        return False

# ============================================
# 🔄 ОБРАБОТЧИК ОТЗЫВОВ
# ============================================

def review_handler(e):
    """Обрабатывает новые отзывы и делает возврат"""
    
    print(f"[BRR] 🔔 Получено событие: {type(e)}")
    
    if not SETTINGS.get("active", True):
        print(f"[BRR] ⏸️ Плагин отключен")
        return
    
    if not SETTINGS.get("refund_enabled", True):
        print(f"[BRR] ⏸️ Возвраты отключены")
        return
    
    try:
        # 🔥 ПОЛУЧАЕМ ДАННЫЕ ОТЗЫВА
        review = None
        
        if hasattr(e, 'review'):
            review = e.review
            print(f"[BRR] 📝 Отзыв из e.review")
        elif hasattr(e, 'message') and hasattr(e.message, 'review'):
            review = e.message.review
            print(f"[BRR] 📝 Отзыв из e.message.review")
        else:
            print(f"[BRR] ⚠️ Не удалось получить отзыв из события")
            return
        
        if not review:
            print(f"[BRR] ⚠️ Отзыв пустой")
            return
        
        # 🔥 ИЗВЛЕКАЕМ ДАННЫЕ
        review_text = review.text if hasattr(review, 'text') else str(review)
        review_stars = review.stars if hasattr(review, 'stars') else 0
        order_id = review.order_id if hasattr(review, 'order_id') else None
        chat_id = e.chat_id if hasattr(e, 'chat_id') else e.chat.id
        
        print(f"[BRR] 📋 Данные отзыва:")
        print(f"[BRR]    Текст: {review_text[:50]}...")
        print(f"[BRR]    Звёзды: {review_stars}")
        print(f"[BRR]    Заказ: {order_id}")
        print(f"[BRR]    Чат: {chat_id}")
        
        # 🔥 ПРОВЕРЯЕМ ПЛОХОЙ ЛИ ОТЗЫВ
        is_bad = False
        reason = []
        
        if SETTINGS.get("check_by_stars", False):
            min_stars = SETTINGS.get("min_stars", 0)
            if review_stars <= min_stars:
                is_bad = True
                reason.append(f"звёзды ({review_stars})")
                print(f"[BRR] ⭐ Проверка по звёздам: {review_stars} <= {min_stars} -> ДА")
            else:
                print(f"[BRR] ⭐ Проверка по звёздам: {review_stars} <= {min_stars} -> НЕТ")
        else:
            if review_text and check_bad_review(review_text):
                is_bad = True
                reason.append("текст")
                print(f"[BRR] 📝 Проверка по тексту: найдены плохие слова -> ДА")
            else:
                print(f"[BRR] 📝 Проверка по тексту: плохих слов нет -> НЕТ")
        
        if not is_bad:
            print(f"[BRR] ✅ Отзыв не является плохим, возврат не требуется")
            return
        
        print(f"[BRR] ⚠️ Обнаружен ПЛОХОЙ отзыв! Причина: {', '.join(reason)}")
        
        # 🔥 ПРОВЕРЯЕМ НЕ ОБРАБАТЫВАЛИ ЛИ УЖЕ
        if order_id and order_id in processed_orders:
            elapsed = time.time() - processed_orders[order_id]
            if elapsed < 3600:
                print(f"[BRR] ⏸️ Заказ {order_id} уже обработан {int(elapsed)}с назад, пропускаем")
                return
        
        if order_id:
            processed_orders[order_id] = time.time()
            print(f"[BRR] 📝 Заказ {order_id} добавлен в историю")
        
        # 🔥 ДЕЛАЕМ ВОЗВРАТ
        if order_id:
            print(f"[BRR] 🔄 Запуск возврата по заказу {order_id}...")
            refund_order(chat_id, order_id, review_text, review_stars)
        else:
            print(f"[BRR] ❌ ID заказа НЕ НАЙДЕН в отзыве!")
        
        # 🔥 ОЧИЩАЕМ СТАРЫЕ ЗАПИСИ
        now = time.time()
        for oid in list(processed_orders.keys()):
            if now - processed_orders[oid] > 86400:
                del processed_orders[oid]
        
    except Exception as e:
        print(f"[BRR] ❌ ОШИБКА обработки отзыва: {e}")
        import traceback
        traceback.print_exc()

