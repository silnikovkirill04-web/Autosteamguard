"""
AutoReply — Автоответы по шаблонам
Создание и настройка шаблонов через меню
"""
import uuid as uuid_lib
import json
import os
import re
import time
import threading
import logging
from datetime import datetime
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

NAME = "AutoReply"
VERSION = "2.5.0"
DESCRIPTION = "Автоответы по шаблонам"
CREDITS = "@qneiz"
UUID = str(uuid_lib.uuid4())
SETTINGS_PAGE = True

CONFIG_PATH = "storage/cache/autoreply.json"
LOG_PATH = "storage/cache/autoreply.log"

cardinal = None
tg = None
bot = None

# 🔥 Логгер
logger = logging.getLogger("AutoReply")
logger.setLevel(logging.INFO)

try:
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    file_handler = logging.FileHandler(LOG_PATH, encoding="utf-8")
    file_handler.setLevel(logging.INFO)
    file_formatter = logging.Formatter('%(asctime)s | %(levelname)s | %(message)s')
    file_handler.setFormatter(file_formatter)
    logger.addHandler(file_handler)
except:
    pass

console_handler = logging.StreamHandler()
console_handler.setLevel(logging.INFO)
console_formatter = logging.Formatter('%(asctime)s | %(levelname)s | %(message)s')
console_handler.setFormatter(console_formatter)
logger.addHandler(console_handler)

# 🔥 НАСТРОЙКИ
DEFAULT_SETTINGS = {
    "active": True,
    "templates": {},  # {id: {"name": "", "time": "", "message": "", "active": True}}
}

SETTINGS = DEFAULT_SETTINGS.copy()
template_counter = 1

# ============================================
# 🔧 СЛУЖЕБНЫЕ ФУНКЦИИ
# ============================================

def load_config():
    global SETTINGS, template_counter
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()
    
    templates = SETTINGS.get("templates", {})
    if templates:
        max_id = max([int(k) for k in templates.keys()]) if templates else 0
        template_counter = max_id + 1

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def get_current_time():
    return datetime.now().strftime("%H:%M")

def check_templates():
    """Проверяет шаблоны и отправляет сообщения"""
    templates = SETTINGS.get("templates", {})
    current_time = get_current_time()
    
    for template_id, template in templates.items():
        try:
            if not template.get("active", True):
                continue
            
            if template.get("time") != current_time:
                continue
            
            last_sent = template.get("last_sent")
            if last_sent:
                last_date = datetime.fromisoformat(last_sent)
                if last_date.date() == datetime.now().date():
                    continue
            
            # Отправляем сообщение во все чаты
            send_template_message(template)
            
            template["last_sent"] = datetime.now().isoformat()
            save_config()
            
            logger.info(f"📤 Отправлен шаблон '{template.get('name', 'Без имени')}'")
            
        except Exception as e:
            logger.error(f"❌ Ошибка шаблона {template_id}: {e}")

def send_template_message(template):
    """Отправляет сообщение по шаблону во все чаты"""
    try:
        # Получаем все чаты (если есть метод)
        if hasattr(cardinal.account, 'get_chats'):
            chats = cardinal.account.get_chats()
        else:
            return
        
        if not chats:
            return
        
        message_text = template.get("message", "")
        if not message_text:
            return
        
        for chat in chats:
            try:
                chat_id = chat.id if hasattr(chat, 'id') else chat
                cardinal.account.send_message(chat_id, message_text)
                time.sleep(0.3)
            except Exception as e:
                logger.error(f"❌ Ошибка отправки: {e}")
                
    except Exception as e:
        logger.error(f"❌ Ошибка отправки шаблона: {e}")

def schedule_worker():
    """Фоновый поток для проверки расписания"""
    while True:
        try:
            if SETTINGS.get("active", True):
                check_templates()
            time.sleep(30)
        except Exception as e:
            logger.error(f"❌ Ошибка в планировщике: {e}")
            time.sleep(60)

# ============================================
# 📱 ИНТЕРФЕЙС
# ============================================

def show_menu(message):
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton(
        f"{'🟢' if SETTINGS.get('active', True) else '🔴'} Плагин: {'ВКЛ' if SETTINGS.get('active', True) else 'ВЫКЛ'}",
        callback_data="ar_toggle"
    ))
    kb.add(InlineKeyboardButton(
        f"📋 Шаблоны ({len(SETTINGS.get('templates', {}))})",
        callback_data="ar_templates"
    ))
    kb.add(InlineKeyboardButton(
        "➕ Добавить шаблон",
        callback_data="ar_add_template"
    ))
    kb.add(InlineKeyboardButton(
        "🔄 Обновить",
        callback_data="ar_refresh"
    ))
    
    text = (
        f"💬 **AutoReply v{VERSION}**\n\n"
        f"📌 **Статус:** {'🟢 Активен' if SETTINGS.get('active', True) else '🔴 Отключён'}\n"
        f"📋 **Шаблонов:** {len(SETTINGS.get('templates', {}))}\n\n"
        f"💬 Создайте шаблон с текстом и временем отправки."
    )
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

def show_templates(message):
    templates = SETTINGS.get("templates", {})
    
    kb = InlineKeyboardMarkup(row_width=1)
    
    if templates:
        text = "📋 **Ваши шаблоны:**\n\n"
        for template_id, template in sorted(templates.items(), key=lambda x: int(x[0])):
            status = "🟢" if template.get("active", True) else "🔴"
            text += f"{status} **{template.get('name', 'Без имени')}**\n"
            text += f"   ⏰ {template.get('time', 'Не указано')}\n"
            text += f"   💬 {template.get('message', '')[:50]}...\n\n"
            
            kb.add(InlineKeyboardButton(
                f"✏️ {template.get('name', 'Без имени')}",
                callback_data=f"ar_edit_template_{template_id}"
            ))
    else:
        text = "📋 **У вас нет шаблонов**\n\nНажмите '➕ Добавить шаблон'"
    
    kb.add(InlineKeyboardButton("➕ Добавить шаблон", callback_data="ar_add_template"))
    kb.add(InlineKeyboardButton("◀️ Назад", callback_data="ar_menu"))
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

def show_template_edit(message, template_id):
    templates = SETTINGS.get("templates", {})
    template = templates.get(template_id, {})
    
    if not template:
        bot.send_message(message.chat.id, "❌ Шаблон не найден")
        show_templates(message)
        return
    
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton(
        f"{'🟢' if template.get('active', True) else '🔴'} Статус",
        callback_data=f"ar_template_toggle_{template_id}"
    ))
    kb.add(InlineKeyboardButton(
        f"✏️ Название: {template.get('name', 'Без имени')}",
        callback_data=f"ar_template_name_{template_id}"
    ))
    kb.add(InlineKeyboardButton(
        f"⏰ Время: {template.get('time', 'Не указано')}",
        callback_data=f"ar_template_time_{template_id}"
    ))
    kb.add(InlineKeyboardButton(
        f"💬 Изменить текст",
        callback_data=f"ar_template_message_{template_id}"
    ))
    kb.add(InlineKeyboardButton(
        f"🗑️ Удалить шаблон",
        callback_data=f"ar_template_delete_{template_id}"
    ))
    kb.add(InlineKeyboardButton("◀️ Назад", callback_data="ar_templates"))
    
    text = (
        f"✏️ **Редактирование шаблона**\n\n"
        f"📌 **Название:** {template.get('name', 'Без имени')}\n"
        f"📌 **Статус:** {'🟢 Активен' if template.get('active', True) else '🔴 Неактивен'}\n"
        f"⏰ **Время:** {template.get('time', 'Не указано')}\n"
        f"💬 **Текст:**\n{template.get('message', 'Не указан')[:200]}..."
    )
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

# ============================================
# 🚀 ИНИЦИАЛИЗАЦИЯ
# ============================================

def init_plugin(c):
    global cardinal, tg, bot, template_counter
    cardinal = c
    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[AR] 💬 ЗАГРУЗКА AutoReply v2.5")
    print("[AR] 🔄 Настройка шаблонов")
    print("=" * 50)
    
    load_config()
    
    c.add_telegram_commands(UUID, [
        ("ar", "💬 Автоответы", True)
    ])
    tg.msg_handler(show_menu, commands=["ar"])
    
    def handle_input(message):
        state = tg.get_state(message.chat.id, message.from_user.id)
        if not state:
            return
        
        action = state.get("action")
        data = state.get("data", {})
        template_id = data.get("template_id")
        
        if action == "ar_add_template_name":
            name = message.text.strip()
            if name:
                templates = SETTINGS.get("templates", {})
                new_id = str(template_counter)
                templates[new_id] = {
                    "name": name,
                    "time": "08:00",
                    "message": "Введите текст сообщения",
                    "active": True,
                    "last_sent": None
                }
                SETTINGS["templates"] = templates
                template_counter += 1
                save_config()
                bot.reply_to(message, f"✅ Шаблон '{name}' создан!")
                show_templates(message)
            else:
                bot.reply_to(message, "❌ Введите название!")
        
        elif action == "ar_template_name":
            new_name = message.text.strip()
            if new_name and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["name"] = new_name
                    save_config()
                    bot.reply_to(message, f"✅ Название обновлено!")
                show_template_edit(message, template_id)
        
        elif action == "ar_template_time":
            time_str = message.text.strip()
            if re.match(r'^\d{2}:\d{2}$', time_str) and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["time"] = time_str
                    save_config()
                    bot.reply_to(message, f"✅ Время обновлено: {time_str}")
                show_template_edit(message, template_id)
            else:
                bot.reply_to(message, "❌ Неверный формат! Используйте HH:MM")
        
        elif action == "ar_template_message":
            new_message = message.text.strip()
            if new_message and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["message"] = new_message
                    save_config()
                    bot.reply_to(message, f"✅ Текст обновлён!")
                show_template_edit(message, template_id)
        
        tg.clear_state(message.chat.id, message.from_user.id)
    
    tg.msg_handler(handle_input, func=lambda m: tg.check_state(m.chat.id, m.from_user.id))
    
    # 🔥 КОЛБЭКИ
    def toggle_cb(call):
        SETTINGS["active"] = not SETTINGS.get("active", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['active'] else 'OFF'}")
        show_menu(call.message)
    
    def refresh_cb(call):
        bot.answer_callback_query(call.id, "🔄 Обновлено")
        show_menu(call.message)
    
    def menu_cb(call):
        bot.answer_callback_query(call.id)
        show_menu(call.message)
    
    def show_templates_cb(call):
        bot.answer_callback_query(call.id)
        show_templates(call.message)
    
    def add_template_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "📝 Введите название нового шаблона:")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_add_template_name")
    
    def edit_template_cb(call):
        template_id = call.data.replace("ar_edit_template_", "")
        bot.answer_callback_query(call.id)
        show_template_edit(call.message, template_id)
    
    def template_toggle_cb(call):
        template_id = call.data.replace("ar_template_toggle_", "")
        templates = SETTINGS.get("templates", {})
        if template_id in templates:
            templates[template_id]["active"] = not templates[template_id].get("active", True)
            save_config()
            bot.answer_callback_query(call.id, f"{'ON' if templates[template_id]['active'] else 'OFF'}")
        show_template_edit(call.message, template_id)
    
    def template_name_cb(call):
        template_id = call.data.replace("ar_template_name_", "")
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "✏️ Введите новое название шаблона:")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_template_name", {"template_id": template_id})
    
    def template_time_cb(call):
        template_id = call.data.replace("ar_template_time_", "")
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "⏰ Введите новое время (HH:MM):")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_template_time", {"template_id": template_id})
    
    def template_message_cb(call):
        template_id = call.data.replace("ar_template_message_", "")
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "💬 Введите новый текст для шаблона:")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_template_message", {"template_id": template_id})
    
    def template_delete_cb(call):
        template_id = call.data.replace("ar_template_delete_", "")
        templates = SETTINGS.get("templates", {})
        if template_id in templates:
            del templates[template_id]
            save_config()
            bot.answer_callback_query(call.id, "🗑️ Шаблон удалён!")
        show_templates(call.message)
    
    tg.cbq_handler(toggle_cb, lambda call: call.data == "ar_toggle")
    tg.cbq_handler(refresh_cb, lambda call: call.data == "ar_refresh")
    tg.cbq_handler(menu_cb, lambda call: call.data == "ar_menu")
    tg.cbq_handler(show_templates_cb, lambda call: call.data == "ar_templates")
    tg.cbq_handler(add_template_cb, lambda call: call.data == "ar_add_template")
    tg.cbq_handler(edit_template_cb, lambda call: call.data.startswith("ar_edit_template_"))
    tg.cbq_handler(template_toggle_cb, lambda call: call.data.startswith("ar_template_toggle_"))
    tg.cbq_handler(template_name_cb, lambda call: call.data.startswith("ar_template_name_"))
    tg.cbq_handler(template_time_cb, lambda call: call.data.startswith("ar_template_time_"))
    tg.cbq_handler(template_message_cb, lambda call: call.data.startswith("ar_template_message_"))
    tg.cbq_handler(template_delete_cb, lambda call: call.data.startswith("ar_template_delete_"))
    
    # 🔥 ЗАПУСКАЕМ ПЛАНИРОВЩИК
    schedule_thread = threading.Thread(target=schedule_worker, daemon=True)
    schedule_thread.start()
    logger.info("🔄 Планировщик запущен")
    
    print("[AR] ✅ Плагин загружен!")
    print("[AR] 📌 /ar — меню настроек")
    print("=" * 50)

# ============================================
# 🔗 ТОЧКИ ВХОДА
# ============================================

BIND_TO_PRE_INIT = [init_plugin]
BIND_TO_DELETE = None
