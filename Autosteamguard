    try:
        text = event.message.text
        if not text:
            return
        text = text.strip()
        sender = event.message.author
        if not sender:
            return

        text_lower = text.lower()
        if text_lower.startswith("/code"):
            _handle_code_command(cardinal, sender, text)

    except Exception as e:
