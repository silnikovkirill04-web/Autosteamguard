    "admin_chat_id": 0,
    "last_reply_time": {},
}

SETTINGS = DEFAULT_SETTINGS.copy()

# ============================================
# 🔧 СЛУЖЕБНЫЕ ФУНКЦИИ
# ============================================

def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def is_work_time():
    now = datetime.now()
    current_time = now.strftime("%H:%M")
    
    start = SETTINGS.get("work_start", "22:30")
    end = SETTINGS.get("work_end", "07:59")
    
    if start > end:
        if current_time >= start and current_time <= "23:59":
            return True
        if current_time >= "00:00" and current_time <= end:
            return True
        return False
    else:
        return start <= current_time <= end

def format_text_with_variables(text, username=None):
    if not text:
        return text
    
    text = text.replace("{date}", datetime.now().strftime("%d.%m.%Y"))
    text = text.replace("{time}", datetime.now().strftime("%H:%M"))
    text = text.replace("{datetime}", datetime.now().strftime("%d.%m.%Y %H:%M:%S"))
    
    if cardinal.account:
        username_acc = cardinal.account.username if hasattr(cardinal.account, 'username') else ""
        text = text.replace("{username}", username_acc)
    
    if username:
        text = text.replace("{buyer_username}", username)
    
    return text

def can_send_reply(chat_id):
    last_reply_time = SETTINGS.get("last_reply_time", {})
    now = time.time()
    last_reply = last_reply_time.get(str(chat_id), 0)
    cooldown = SETTINGS.get("reply_cooldown", 86400)
    
    if now - last_reply < cooldown:
        return False
    
    return True

def update_last_reply(chat_id):
    last_reply_time = SETTINGS.get("last_reply_time", {})
    last_reply_time[str(chat_id)] = time.time()
    SETTINGS["last_reply_time"] = last_reply_time
    save_config()

# ============================================
# 🔄 ОБРАБОТЧИК СООБЩЕНИЙ (ИСПРАВЛЕН)
# ============================================

def message_handler(msg_obj, *args):
    """
    Обрабатывает новое сообщение через хук BIND_TO_NEW_MESSAGE
    Принимает 1 или 2 аргумента (совместимость с разными версиями Cardinal)
    """
    
    if not SETTINGS.get("active", True):
        return
    
    if not is_work_time():
        return
    
    try:
        # 🔥 Если передан 1 аргумент — это объект сообщения
        # Если передан 2 аргумента — это (event, message) или (message, something)
        # Определяем, что у нас в переменной msg_obj
        
        # Если msg_obj — это событие с атрибутом message
        if hasattr(msg_obj, 'message'):
            msg = msg_obj.message
        else:
            msg = msg_obj
        
        # Проверяем, что сообщение не от нас
        if getattr(msg, "is_employee", False):
            return
        
        # Получаем chat_id
        chat_id = getattr(msg, "chat_id", None) or getattr(msg, "node_id", None)
        if not chat_id:
            return
        
        # Проверяем КД
        if not can_send_reply(chat_id):
            return
        
        # Получаем имя покупателя
        username = None
        if hasattr(msg, "author"):
            username = msg.author
        elif hasattr(msg, "user_name"):
            username = msg.user_name
        
        # Отправляем ответ
        try:
            reply_text = SETTINGS.get("reply_message", 
                "Здравствуйте! Я сейчас сплю😴 Если вы не против я выполню ваш заказ завтра начав примерно в 8 утра по МСК, оставьте все нужные данные, информацию для выполнения работы, либо сразу запросите возврат.")
            reply_text = format_text_with_variables(reply_text, username)
            
            if hasattr(cardinal.account, 'send_message'):
                cardinal.account.send_message(chat_id, reply_text)
            else:
                cardinal.send_message(chat_id, reply_text)
            
            update_last_reply(chat_id)
            
            logger.info(f"📤 Отправлен автоответ в чат {chat_id}")
            
            if SETTINGS.get("admin_notify", True):
                admin_id = SETTINGS.get("admin_chat_id", 0)
                if admin_id:
                    admin_msg = (
                        f"💬 **Автоответ отправлен!**\n\n"
                        f"🆔 Чат: {chat_id}\n"
                        f"👤 Пользователь: {username or 'Неизвестно'}\n"
                        f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
                    )
                    cardinal.send_message(admin_id, admin_msg)
        except Exception as e:
            logger.error(f"❌ Ошибка отправки ответа: {e}")
        
    except Exception as e:
        logger.error(f"❌ Ошибка обработки сообщения: {e}")

