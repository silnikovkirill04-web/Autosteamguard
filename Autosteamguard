def check_rental_expiration(cardinal: Cardinal):
    logger.info("[STEAM EXPIRATION] 🚀 Запущен поток проверки аренды")
    invalid_accounts = []
    lot_check_counter = 0

    while True:
        try:
            interval = config.get("rental_check_interval", 30)
            time.sleep(interval)

            lot_check_counter += 1
            if lot_check_counter >= 5:
                lot_check_counter = 0
                update_lot_states(cardinal)

            active_rentals = db.get_active_rentals()

            if not active_rentals:
                continue

            current_time = get_current_time_with_offset()

            for rental in active_rentals:
                account_id = rental["id"]

                if account_id in invalid_accounts:
                    continue

                owner = rental["owner"]
                start_time_str = rental["rental_start"]
                duration_hours = float(rental["rental_duration"])

                start_datetime = datetime.strptime(start_time_str, "%Y-%m-%d %H:%M:%S")
                expiry_time = start_datetime + timedelta(hours=duration_hours)

                if current_time >= expiry_time:
                    logger.info(f"[STEAM EXPIRATION] ⏰ Срок аренды истёк для аккаунта {account_id} (владелец: {owner})")

                    if config.get("auto_password_change", True):
                        new_password = asyncio.run(
                            change_steam_password(rental["mafile_path"], rental["password"])
                        )

                        if new_password:
                            db.reset_account(account_id, new_password)

                            if rental["chat_id"]:
                                try:
                                    msg = config["messages"]["rental_expired"].format(
                                        login=rental["login"]
                                    )
                                    cardinal.send_message(rental["chat_id"], msg)
                                except Exception as e:
                                    logger.error(f"[STEAM EXPIRATION] Не удалось уведомить: {e}")

                            admin_msg = formatting.format_text(
                                formatting.hbold("🔐 Steam - Пароль изменён"),
                                "━━━━━━━━━━━━━━━━━━",
                                f"{formatting.hbold('Владелец:')} {formatting.hcode(owner)}",
                                f"{formatting.hbold('ID аккаунта:')} {formatting.hcode(str(account_id))}",
                                f"{formatting.hbold('Логин:')} {formatting.hcode(rental['login'])}",
                                f"{formatting.hbold('Новый пароль:')} {formatting.hcode(new_password)}",
                                separator="\n"
                            )
                            users = load_authorized_users()
                            for user_id in users:
                                try:
                                    cardinal.telegram.bot.send_message(user_id, admin_msg, parse_mode='HTML')
                                except:
                                    pass

                            logger.info(f"[STEAM EXPIRATION] ✅ Пароль изменён для аккаунта {account_id}")

                            update_lot_states(cardinal)
                        else:
                            logger.error(f"[STEAM EXPIRATION] ❌ Не удалось изменить пароль для {account_id}")
                            invalid_accounts.append(account_id)
                            users = load_authorized_users()
                            for user_id in users:
                                try:
                                    cardinal.telegram.bot.send_message(
                                        user_id,
                                        f"⚠️ Ошибка смены пароля для аккаунта #{account_id} ({rental['login']})"
                                    )
                                except:
                                    pass
                    else:
                        db.reset_account(account_id, rental["password"])

                        if rental["chat_id"]:
                            try:
                                msg = config["messages"]["rental_expired"].format(login=rental["login"])
                                cardinal.send_message(rental["chat_id"], msg)
                            except:
                                pass

                        logger.info(f"[STEAM EXPIRATION] Аренда аккаунта {account_id} завершена (без смены пароля)")
                        update_lot_states(cardinal)

        except Exception as e:
            logger.error(f"[STEAM EXPIRATION] Критическая ошибка: {e}", exc_info=True)


