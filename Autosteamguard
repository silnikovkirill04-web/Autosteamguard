        keyboard.add(InlineKeyboardButton("🔙 Назад", callback_data=f"steam_gt_view_{game_type_id}"))
        cardinal.telegram.bot.edit_message_text(
            "📋 <b>Лоты:</b>", call.message.chat.id, call.message.message_id,
            reply_markup=keyboard, parse_mode='HTML'
        )

    elif call.data.startswith("steam_lot_view_"):
        cardinal.telegram.bot.answer_callback_query(call.id)
        lot_id = int(call.data.replace("steam_lot_view_", ""))
        cursor = db.conn.cursor()
        cursor.execute("""
            SELECT l.lot_name, l.lot_id, l.rental_duration, l.game_type_id, g.name
            FROM lots l JOIN game_types g ON l.game_type_id = g.ID WHERE l.ID = ?
        """, (lot_id,))
        result = cursor.fetchone()
        if not result:
            cardinal.telegram.bot.edit_message_text("❌ Не найден", call.message.chat.id, call.message.message_id)
            return
        lot_name, funpay_lot_id, rental_duration, game_type_id, game_type_name = result
        keyboard = InlineKeyboardMarkup()
        keyboard.add(InlineKeyboardButton("🗑️ Отвязать", callback_data=f"steam_lot_unbind_{lot_id}"))
        keyboard.add(InlineKeyboardButton("🔙 Назад", callback_data=f"steam_gt_lots_{game_type_id}"))
        time_display = format_rental_duration(rental_duration) if rental_duration else "не задано"
        auto_mgmt = "✅ Да" if funpay_lot_id else "❌ Нет (ID не указан)"
        cardinal.telegram.bot.edit_message_text(
            f"📦 <b>Лот</b>\n\n"
            f"🎮 Тип: <code>{game_type_name}</code>\n"
            f"📝 Название:\n<code>{lot_name}</code>\n\n"
            f"🆔 ID: <code>{funpay_lot_id if funpay_lot_id else 'не указан'}</code>\n"
            f"⏰ Срок: <b>{time_display}</b>\n"
            f"🔄 Автоуправление: {auto_mgmt}",
            call.message.chat.id, call.message.message_id,
            reply_markup=keyboard, parse_mode='HTML'
        )

    elif call.data.startswith("steam_lot_unbind_"):
        cardinal.telegram.bot.answer_callback_query(call.id)
        lot_id = int(call.data.replace("steam_lot_unbind_", ""))
        cursor = db.conn.cursor()
        cursor.execute("SELECT lot_name, game_type_id FROM lots WHERE ID = ?", (lot_id,))
        result = cursor.fetchone()
        if result:
            lot_name, game_type_id = result
            if db.delete_lot(lot_id):
                back_keyboard = InlineKeyboardMarkup()
                back_keyboard.add(InlineKeyboardButton("🔙 В меню", callback_data="steam_back_main"))
                cardinal.telegram.bot.edit_message_text(
                    f"✅ Лот отвязан!\n\n<code>{lot_name}</code>",
                    call.message.chat.id, call.message.message_id,
                    reply_markup=back_keyboard, parse_mode='HTML'
                )

    elif call.data == "steam_gt_create":
        cardinal.telegram.bot.answer_callback_query(call.id)
        cardinal.telegram.bot.edit_message_text(
            "➕ <b>Новый тип игры</b>\n\nВведите название:\n\n"
            "Примеры: <code>DayZ Standard</code>, <code>CS2 Prime</code>",
            call.message.chat.id, call.message.message_id, parse_mode='HTML'
        )

        def handle_new_game_type_name(message: Message):
            try:
                name = message.text.strip()
                if not name:
                    cardinal.telegram.bot.send_message(message.chat.id, "❌ Пустое название")
                    return
                result = db.add_game_type(name)
                if result:
                    cardinal.telegram.bot.send_message(
                        message.chat.id,
                        f"✅ Тип игры <code>{name}</code> создан! (ID: {result})",
                        parse_mode='HTML'
                    )
                else:
                    cardinal.telegram.bot.send_message(message.chat.id, f"❌ Тип '{name}' уже существует")
            except Exception as e:
                logger.error(f"[STEAM GT] Ошибка: {e}")

        cardinal.telegram.bot.register_next_step_handler_by_chat_id(
            call.message.chat.id, handle_new_game_type_name
        )

    elif call.data.startswith("steam_gt_delete_"):
        cardinal.telegram.bot.answer_callback_query(call.id)
        game_type_id = int(call.data.replace("steam_gt_delete_", ""))
        if db.delete_game_type(game_type_id):
            back_keyboard = InlineKeyboardMarkup()
            back_keyboard.add(InlineKeyboardButton("🔙 В меню", callback_data="steam_back_main"))
            cardinal.telegram.bot.edit_message_text(
                "✅ Тип игры удалён!",
                call.message.chat.id, call.message.message_id,
                reply_markup=back_keyboard, parse_mode='HTML'
            )
        else:
            cardinal.telegram.bot.edit_message_text("❌ Ошибка удаления", call.message.chat.id, call.message.message_id)

    elif call.data == "steam_timezone":
        cardinal.telegram.bot.answer_callback_query(call.id)
        current_offset = config.get("timezone_offset", 3)
        cardinal.telegram.bot.send_message(
            call.message.chat.id,
            f"🌍 <b>Часовой пояс</b>\n\n"
            f"Текущий: <b>{get_timezone_name()} (UTC{current_offset:+d})</b>\n\n"
            f"Введите смещение от UTC:\n"
            f"• <code>3</code> - МСК\n• <code>0</code> - UTC\n• <code>-5</code> - EST",
            parse_mode='HTML'
        )
        cardinal.telegram.bot.register_next_step_handler(
            call.message, lambda msg: handle_timezone_input(msg, cardinal)
        )


def init_plugin(cardinal: Cardinal) -> None:
    global config, db

    logger.info(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    logger.info(f"🎮 Загрузка плагина {NAME} v{VERSION}")
    logger.info(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    os.makedirs(PLUGIN_DIR, exist_ok=True)
    os.makedirs(MAFILES_DIR, exist_ok=True)

    logger.info("[STEAM INIT] 🔧 Проверка зависимостей...")
    try:
        import importlib
        missing_before = []
        for import_name in REQUIRED_LIBRARIES.keys():
            try:
                importlib.import_module(import_name)
            except ImportError:
                missing_before.append(import_name)
        had_missing = len(missing_before) > 0
        libraries_ok = check_and_install_libraries()

        if had_missing and libraries_ok:
            try:
                users = load_authorized_users()
                for uid in users:
                    cardinal.telegram.bot.send_message(
                        uid,
                        "🎮 <b>Steam Auto Rental</b>\n\n"
                        "✅ Зависимости установлены!\n"
                        "⚠️ Перезапустите Cardinal!",
                        parse_mode='HTML'
                    )
            except:
                pass
    except Exception as e:
        logger.error(f"[STEAM INIT] ❌ Ошибка установки зависимостей: {e}")

    modules_available = check_steam_modules_available()

    config = load_config()
    logger.info("[STEAM INIT] ✅ Конфигурация загружена")

    db = SteamAccountsDB()
    logger.info("[STEAM INIT] ✅ База данных инициализирована")

    register_telegram_commands(cardinal)
    cardinal.add_telegram_commands(UUID, [
        ("steam_arenda_settings", "Настройки Steam Auto Rental", True),
    ])
    logger.info("[STEAM INIT] ✅ Telegram команды зарегистрированы")

    expiration_thread = threading.Thread(
        target=check_rental_expiration,
        args=(cardinal,),
        daemon=True,
        name="SteamExpirationChecker"
    )
    expiration_thread.start()
    logger.info("[STEAM INIT] ✅ Поток проверки аренды запущен")

    update_lot_states(cardinal)

    accounts_count = len(db.get_all_accounts())
    if accounts_count == 0:
        logger.warning("[STEAM INIT] ⚠️ В базе нет аккаунтов!")
    else:
        logger.info(f"[STEAM INIT] ✅ Загружено {accounts_count} аккаунтов")

    logger.info(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    logger.info(f"✅ Плагин {NAME} v{VERSION} загружен!")
    logger.info(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    try:
        users = load_authorized_users()
        status_icon = "✅" if modules_available else "⚠️"
        status_text = "полностью" if modules_available else "БЕЗ автосмены паролей"
        auto_lot = "✅" if config.get("auto_lot_management", True) else "❌"
        for uid in users:
            cardinal.telegram.bot.send_message(
                uid,
                f"{status_icon} <b>Steam Auto Rental v{VERSION}</b>\n\n"
                f"Плагин работает {status_text}!\n\n"
                f"• Аккаунтов: {accounts_count}\n"
                f"• Автосмена: {'✅' if modules_available else '❌'}\n"
                f"• Автолоты: {auto_lot}\n\n"
                f"/steam_arenda_settings",
                parse_mode='HTML'
            )
    except Exception as e:
        logger.error(f"[STEAM INIT] Не удалось отправить уведомление: {e}")


