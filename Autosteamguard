def message_handler(e):
    """Обрабатывает новое сообщение через событие NEW_MESSAGE"""
    
    if not SETTINGS.get("active", True):
        return
    
    if not SETTINGS.get("auto_reply_enabled", True):
        return
    
    try:
        # 🔥 ПОЛУЧАЕМ ДАННЫЕ ИЗ СОБЫТИЯ
        message = getattr(e, 'message', None)
        if not message:
            return
        
        # Проверяем, что сообщение не от нас
        if hasattr(message, 'author_id') and message.author_id == cardinal.account.id:
            return
        
        # Проверяем, что это не системное сообщение
        if getattr(message, 'is_system', False):
            return
        
        chat_id = getattr(message, 'chat_id', None)
        if not chat_id:
            return
        
        # Проверяем КД
        if not can_send_reply(chat_id):
            return
        
        msg_text = getattr(message, 'text', '')
        if not msg_text:
            return
        
        # Получаем имя пользователя
        username = None
        if hasattr(message, 'author'):
            username = message.author
        elif hasattr(message, 'author_id'):
            try:
                # Пробуем получить пользователя
                user = cardinal.account.get_user(message.author_id)
                if user:
                    username = user.name if hasattr(user, 'name') else None
            except:
                pass
        
        # 🔥 ОТПРАВЛЯЕМ ОТВЕТ С ЗАДЕРЖКОЙ
        delay = get_delay_seconds()
        
        def send_reply():
            time.sleep(delay)
            try:
                # Проверяем КД еще раз
                if not can_send_reply(chat_id):
                    return
                
                reply_text = SETTINGS.get("reply_message", 
                    "Здравствуйте! Я сейчас не у экрана. Оставьте ваше сообщение, я отвечу в ближайшее время.")
                reply_text = format_text_with_variables(reply_text, chat_id, None, username)
                
                # 🔥 ПРАВИЛЬНАЯ ОТПРАВКА СООБЩЕНИЯ В ЧАТ
                cardinal.send_message(chat_id, reply_text)
                
                update_last_reply(chat_id)
                
                logger.info(f"📤 Отправлен автоответ в чат {chat_id} (задержка {delay}с)")
                
                if SETTINGS.get("admin_notify", True):
                    admin_id = SETTINGS.get("admin_chat_id")
                    if admin_id:
                        admin_msg = (
                            f"💬 **Автоответ отправлен!**\n\n"
                            f"🆔 Чат: {chat_id}\n"
                            f"👤 Пользователь: {username or 'Неизвестно'}\n"
                            f"💬 Сообщение: {msg_text[:50]}...\n"
                            f"⏱ Задержка: {delay}с\n"
                            f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
                        )
                        cardinal.send_message(admin_id, admin_msg)
            except Exception as e:
                logger.error(f"❌ Ошибка отправки ответа: {e}")
        
        threading.Thread(target=send_reply, daemon=True).start()
        
    except Exception as e:
        logger.error(f"❌ Ошибка обработки сообщения: {e}")

