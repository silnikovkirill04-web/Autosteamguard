    days = cooldown // 86400
    hours = (cooldown % 86400) // 3600
    minutes = (cooldown % 3600) // 60
    
    text = (
        f"⏰ **Настройка КД**\n\n"
        f"Текущее КД: **{cooldown} секунд**\n"
        f"({days} дн {hours} ч {minutes} мин)\n\n"
        f"Введите новое значение в секундах:"
    )
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

# ============================================
# 🚀 ИНИЦИАЛИЗАЦИЯ
