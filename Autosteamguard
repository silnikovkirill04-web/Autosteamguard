def get_install_command() -> str:
    import platform
    base = "pysteamauth steamlib selenium webdriver-manager rsa lxml pydantic aiohttp fake-useragent pytz yarl"
    if platform.system() == "Linux":
        return f"pip install {base} --break-system-packages"
    return f"pip install {base}"


def handle_timezone_input(message: Message, cardinal: Cardinal):
    try:
        offset_str = message.text.strip()
        try:
            offset = int(offset_str)
        except ValueError:
            cardinal.telegram.bot.send_message(
                message.chat.id,
                "❌ Введите целое число от -12 до +14.",
                parse_mode='HTML'
            )
            return
        if offset < -12 or offset > 14:
            cardinal.telegram.bot.send_message(message.chat.id, "❌ Диапазон: от -12 до +14.")
            return
        config["timezone_offset"] = offset
        save_config(config)
        cardinal.telegram.bot.send_message(
            message.chat.id,
            f"✅ <b>Часовой пояс изменён!</b>\n\n"
            f"Новый часовой пояс: <b>{get_timezone_name()} (UTC{offset:+d})</b>",
            parse_mode='HTML'
        )
    except Exception as e:
        logger.error(f"[STEAM TIMEZONE] Ошибка: {e}")


