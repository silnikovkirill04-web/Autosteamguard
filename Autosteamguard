# ============================================
# 🔧 СЛУЖЕБНЫЕ ФУНКЦИИ
# ============================================

def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def check_bad_review(text):
    """Проверяет текст на наличие негативных слов (с регулярками)"""
    if not text:
        return False
    
    text_lower = text.lower()
    
    for word in SETTINGS.get("bad_words", []):
        # Ищем слово как отдельное (не в составе других слов)
        pattern = r'\b' + re.escape(word.lower()) + r'\b'
        if re.search(pattern, text_lower):
            return True
    
    return False

def get_order_price(order):
    """Получает сумму заказа"""
    try:
        if hasattr(order, 'price'):
            return float(order.price)
        elif hasattr(order, 'amount'):
            return float(order.amount)
        else:
            return 0
    except:
        return 0

def make_refund(order_id, chat_id):
    """Делает возврат по заказу"""
    try:
        # 🔥 ПРАВИЛЬНЫЙ СПОСОБ: через аккаунт
        result = cardinal.account.refund(order_id)
        if result:
            logger.info(f"✅ Возврат по заказу {order_id} выполнен!")
            return True
        else:
            logger.error(f"❌ Возврат по заказу {order_id} не удался")
            return False
    except Exception as e:
        logger.error(f"❌ Ошибка возврата: {e}")
        return False

# ============================================
# 🔄 ФОНОВЫЙ ПРОВЕРЩИК ОТЗЫВОВ
# ============================================

def review_checker():
    """Фоновый поток, проверяющий новые отзывы"""
    global checker_running
    
    logger.info("🔄 Запущен фоновый проверщик отзывов")
    
    while SETTINGS.get("active", True):
        try:
            if not SETTINGS.get("refund_enabled", True):
                time.sleep(SETTINGS.get("check_interval", 60))
                continue
            
            # 🔥 ПОЛУЧАЕМ ПОСЛЕДНИЕ ОТЗЫВЫ
            # В разных версиях Cardinal метод может отличаться
            reviews = []
            try:
                # Пробуем получить отзывы через аккаунт
                if hasattr(cardinal.account, 'get_reviews'):
                    reviews = cardinal.account.get_reviews(limit=10)
                elif hasattr(cardinal.account, 'get_feedbacks'):
                    reviews = cardinal.account.get_feedbacks(limit=10)
                else:
                    # Если нет прямого метода, проверяем чаты
                    check_chats_for_reviews()
                    time.sleep(SETTINGS.get("check_interval", 60))
                    continue
            except Exception as e:
                logger.warning(f"⚠️ Не удалось получить отзывы: {e}")
                time.sleep(SETTINGS.get("check_interval", 60))
                continue
            
            if not reviews:
                time.sleep(SETTINGS.get("check_interval", 60))
                continue
            
            # 🔥 ПРОВЕРЯЕМ КАЖДЫЙ ОТЗЫВ
            for review in reviews:
                try:
                    # Получаем данные из отзыва
                    review_text = getattr(review, 'text', '') or ''
                    review_stars = getattr(review, 'stars', 0)
                    order_id = getattr(review, 'order_id', None)
                    chat_id = getattr(review, 'chat_id', None)
                    
                    if not order_id:
                        continue
                    
                    # Проверяем, не обрабатывали ли уже
                    processed = SETTINGS.get("processed_orders", {})
                    if order_id in processed:
                        elapsed = time.time() - processed[order_id]
                        if elapsed < 86400:  # 24 часа
                            continue
                    
                    # Проверяем сумму заказа
                    try:
                        order = cardinal.account.get_order(order_id)
                        if order:
                            order_price = get_order_price(order)
                            max_price = SETTINGS.get("max_refund_price", 10)
                            if order_price > max_price:
                                continue
                    except:
                        pass
                    
                    # 🔥 ОПРЕДЕЛЯЕМ, ПЛОХОЙ ЛИ ОТЗЫВ
                    is_bad = False
                    reason = ""
                    
                    if review_stars <= 4:
                        is_bad = True
                        reason = f"низкая оценка ({review_stars} звезд)"
                    elif review_stars == 5 and review_text and check_bad_review(review_text):
                        is_bad = True
                        reason = "плохие слова в отзыве (5 звезд)"
                    
                    if not is_bad:
                        continue
                    
                    # 🔥 ДЕЛАЕМ ВОЗВРАТ
                    logger.info(f"⚠️ Плохой отзыв по заказу {order_id}: {reason}")
                    
                    if chat_id:
                        # Отправляем уведомление
                        cardinal.send_message(chat_id, "⏳ Проверяю возможность возврата...")
                    
                    if make_refund(order_id, chat_id):
                        # Отмечаем как обработанный
                        SETTINGS["processed_orders"][order_id] = time.time()
                        save_config()
                        
                        # Отправляем сообщение о возврате
                        refund_msg = SETTINGS.get("refund_message", "✅ Возврат выполнен. Извините за неудобства!")
                        if chat_id:
                            cardinal.send_message(chat_id, refund_msg)
                        
                        # Уведомление админу
                        if SETTINGS.get("admin_notify", True):
                            admin_id = SETTINGS.get("admin_chat_id")
                            if admin_id:
                                admin_msg = (
                                    f"💰 **Возврат выполнен!**\n\n"
                                    f"🆔 Заказ: {order_id}\n"
                                    f"⭐ Оценка: {review_stars} звезд\n"
                                    f"💬 Причина: {reason}\n"
                                    f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
                                )
                                cardinal.send_message(admin_id, admin_msg)
                    else:
                        if chat_id:
                            cardinal.send_message(chat_id, "❌ Не удалось выполнить возврат")
                    
                except Exception as e:
                    logger.error(f"❌ Ошибка обработки отзыва: {e}")
                    continue
            
            # Ждем до следующей проверки
            time.sleep(SETTINGS.get("check_interval", 60))
            
        except Exception as e:
            logger.error(f"❌ Ошибка в проверщике отзывов: {e}")
            time.sleep(30)
    
    checker_running = False
    logger.info("⏹️ Проверщик отзывов остановлен")

def check_chats_for_reviews():
    """Альтернативный метод: проверяем чаты на наличие отзывов"""
    try:
        chats = cardinal.account.get_chats(update=True)
        if not chats:
            return
        
        for chat_id, chat in chats.items():
            try:
                # Проверяем последние сообщения в чате
                msgs = cardinal.account.get_chat_history(chat_id, limit=5)
                for msg in msgs:
                    # Ищем сообщения с отзывами
                    if hasattr(msg, 'review') and msg.review:
                        review = msg.review
                        review_text = getattr(review, 'text', '') or ''
                        review_stars = getattr(review, 'stars', 0)
                        order_id = getattr(review, 'order_id', None)
                        
                        if not order_id:
                            continue
                        
                        # Проверяем, плохой ли отзыв
                        is_bad = False
                        if review_stars <= 4:
                            is_bad = True
                        elif review_stars == 5 and review_text and check_bad_review(review_text):
                            is_bad = True
                        
                        if is_bad:
                            logger.info(f"⚠️ Найден плохой отзыв в чате {chat_id}, заказ {order_id}")
                            # Дальше логика такая же как выше
            except:
                continue
    except:
        pass

