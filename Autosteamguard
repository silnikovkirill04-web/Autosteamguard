def load_config() -> Dict[str, Any]:
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)

    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, ensure_ascii=False, indent=4)
        return DEFAULT_CONFIG.copy()

    with open(CONFIG_FILE, "r", encoding="utf-8") as f:
        cfg = json.load(f)

    updated = False
    for key, value in DEFAULT_CONFIG.items():
        if key not in cfg:
            cfg[key] = value
            updated = True

    if updated:
        save_config(cfg)
    return cfg


def save_config(cfg: Dict[str, Any]) -> None:
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=4)
    except Exception as e:
        logger.error(f"Ошибка сохранения конфигурации: {e}")


def get_current_time_with_offset() -> datetime:
    global config
    offset = config.get("timezone_offset", 3)
    return datetime.utcnow() + timedelta(hours=offset)


def get_timezone_name() -> str:
    global config
    offset = config.get("timezone_offset", 3)
    timezone_names = {
        0: "UTC", 3: "МСК", 2: "EET", 1: "CET", -5: "EST", -8: "PST",
    }
    if offset in timezone_names:
        return timezone_names[offset]
    elif offset > 0:
        return f"UTC+{offset}"
    elif offset < 0:
        return f"UTC{offset}"
    else:
        return "UTC"


def format_rental_duration(hours: float) -> str:
    if hours is None:
        return "не задано"
    hours = float(hours)
    if hours >= 1:
        full_hours = int(hours)
        minutes = int(round((hours - full_hours) * 60))
        if minutes == 0:
            return f"{full_hours} ч."
        else:
            return f"{full_hours} ч. {minutes} мин."
    else:
        minutes = int(round(hours * 60))
        if minutes <= 0:
            minutes = 1
        return f"{minutes} мин."


def format_bonus_display(bonus_minutes: float) -> str:
    bonus_minutes = float(bonus_minutes)
    if bonus_minutes >= 60:
        hours = int(bonus_minutes // 60)
        mins = int(bonus_minutes % 60)
        if mins > 0:
            return f"{hours} ч. {mins} мин."
        else:
            return f"{hours} ч."
    else:
        return f"{int(bonus_minutes)} мин."


class SteamAccountsDB:
    def __init__(self):
        os.makedirs(os.path.dirname(ACCOUNTS_DB), exist_ok=True)
        self.conn = sqlite3.connect(ACCOUNTS_DB, check_same_thread=False)
        self._lock = threading.Lock()
        self._create_tables()

    def _create_tables(self):
        cursor = self.conn.cursor()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS game_types (
                ID INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE,
                description TEXT DEFAULT NULL,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS lots (
                ID INTEGER PRIMARY KEY AUTOINCREMENT,
                game_type_id INTEGER NOT NULL,
                lot_name TEXT NOT NULL,
                lot_id TEXT DEFAULT NULL,
                rental_duration REAL DEFAULT NULL,
                FOREIGN KEY (game_type_id) REFERENCES game_types(ID) ON DELETE CASCADE,
                UNIQUE(game_type_id, lot_name)
            )
        """)

        cursor.execute("PRAGMA table_info(lots)")
        lot_columns = [column[1] for column in cursor.fetchall()]
        if 'lot_id' not in lot_columns:
            cursor.execute("ALTER TABLE lots ADD COLUMN lot_id TEXT DEFAULT NULL")
            self.conn.commit()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS accounts (
                ID INTEGER PRIMARY KEY AUTOINCREMENT,
                account_name TEXT NOT NULL,
                path_to_maFile TEXT NOT NULL,
                login TEXT NOT NULL,
                password TEXT NOT NULL,
                rental_duration REAL NOT NULL,
                game_type_id INTEGER NOT NULL,
                owner TEXT DEFAULT NULL,
                rental_start TIMESTAMP DEFAULT NULL,
                chat_id INTEGER DEFAULT NULL,
                order_id TEXT DEFAULT NULL,
                bonus_awarded INTEGER DEFAULT 0,
                FOREIGN KEY (game_type_id) REFERENCES game_types(ID) ON DELETE CASCADE
            )
        """)

        cursor.execute("PRAGMA table_info(accounts)")
        columns = [column[1] for column in cursor.fetchall()]
        if 'game_tag' in columns and 'game_type_id' not in columns:
            logger.info("[STEAM DB] 🔄 Миграция со старой схемы на новую...")
            cursor.execute("ALTER TABLE accounts ADD COLUMN game_type_id INTEGER")
            cursor.execute("SELECT DISTINCT game_tag FROM accounts WHERE game_tag IS NOT NULL")
            old_tags = cursor.fetchall()
            for (tag,) in old_tags:
                cursor.execute("INSERT OR IGNORE INTO game_types (name) VALUES (?)", (tag,))
                cursor.execute("SELECT ID FROM game_types WHERE name = ?", (tag,))
                game_type_id = cursor.fetchone()[0]
                cursor.execute("UPDATE accounts SET game_type_id = ? WHERE game_tag = ?", (game_type_id, tag))
            logger.info("[STEAM DB] ✅ Миграция завершена")

        if 'bonus_awarded' not in columns:
            cursor.execute("ALTER TABLE accounts ADD COLUMN bonus_awarded INTEGER DEFAULT 0")

        self.conn.commit()
        logger.info("[STEAM DB] Таблицы созданы/проверены")

    def add_game_type(self, name: str, description: str = None) -> Optional[int]:
        try:
            with self._lock:
                cursor = self.conn.cursor()
                cursor.execute("INSERT INTO game_types (name, description) VALUES (?, ?)", (name, description))
                self.conn.commit()
                game_type_id = cursor.lastrowid
                logger.info(f"[STEAM DB] Добавлен тип игры '{name}' (ID: {game_type_id})")
                return game_type_id
        except sqlite3.IntegrityError:
            logger.warning(f"[STEAM DB] Тип игры '{name}' уже существует")
            return None
        except Exception as e:
            logger.error(f"[STEAM DB] Ошибка добавления типа игры: {e}")
            return None

    def get_all_game_types(self) -> List[Dict]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT ID, name, description FROM game_types ORDER BY name")
        return [{"id": r[0], "name": r[1], "description": r[2]} for r in cursor.fetchall()]

    def delete_game_type(self, game_type_id: int) -> bool:
        try:
            with self._lock:
                cursor = self.conn.cursor()
                cursor.execute("DELETE FROM game_types WHERE ID = ?", (game_type_id,))
                success = cursor.rowcount > 0
                self.conn.commit()
                return success
        except Exception as e:
            logger.error(f"[STEAM DB] Ошибка удаления типа игры: {e}")
            return False

    def add_lot(self, game_type_id: int, lot_name: str, lot_id: Optional[str] = None,
                rental_duration: Optional[float] = None) -> Optional[int]:
        try:
            with self._lock:
                cursor = self.conn.cursor()
                cursor.execute(
                    "INSERT INTO lots (game_type_id, lot_name, lot_id, rental_duration) VALUES (?, ?, ?, ?)",
                    (game_type_id, lot_name, lot_id, rental_duration)
                )
                self.conn.commit()
                db_lot_id = cursor.lastrowid
                logger.info(f"[STEAM DB] Добавлен лот '{lot_name}' (FunPay ID: {lot_id}) к типу {game_type_id}")
                return db_lot_id
        except sqlite3.IntegrityError:
            logger.warning(f"[STEAM DB] Лот '{lot_name}' уже существует для этого типа")
            return None
        except Exception as e:
            logger.error(f"[STEAM DB] Ошибка добавления лота: {e}")
