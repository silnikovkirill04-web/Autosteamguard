# 🔥 НАСТРОЙКИ
DEFAULT_SETTINGS = {
    "active": True,
    "reply_message": "Здравствуйте! Я сейчас сплю😴 Если вы не против я выполню ваш заказ завтра начав примерно в 8 утра по МСК, оставьте все нужные данные, информацию для выполнения работы, либо сразу запросите возврат.",
