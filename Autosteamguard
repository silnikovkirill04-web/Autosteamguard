def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        print(f"[BRR] ❌ Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        print(f"[BRR] ❌ Ошибка сохранения: {e}")

def check_bad_review(text):
    """Проверяет текст на наличие негативных слов"""
    if not text:
        return False
    
    text_lower = text.lower()
    
    for word in SETTINGS.get("bad_words", []):
        if word.lower() in text_lower:
            return True
        
        word_no_spaces = word.replace(" ", "")
        if word_no_spaces and word_no_spaces in text_lower.replace(" ", ""):
            return True
    
    return False

def get_order_price(order):
    """Получает сумму заказа"""
    try:
        if hasattr(order, 'price'):
            return float(order.price)
        elif hasattr(order, 'amount'):
            return float(order.amount)
        else:
            return 0
    except:
        return 0

def refund_order(chat_id, order_id, review_text, review_stars, reason_text):
    """Делает возврат по заказу"""
    print(f"[BRR] 🔄 Начинаю возврат по заказу {order_id}")
    
    try:
        # Получаем заказ
        print(f"[BRR] 📦 Получаю заказ {order_id}...")
        order = cardinal.account.get_order(order_id)
        
        if not order:
            print(f"[BRR] ❌ Заказ {order_id} НЕ НАЙДЕН!")
            return False
        
        print(f"[BRR] ✅ Заказ найден")
        
        # 🔥 ПРОВЕРЯЕМ СУММУ ЗАКАЗА
        order_price = get_order_price(order)
        max_price = SETTINGS.get("max_refund_price", 10)
        
        print(f"[BRR] 💰 Сумма заказа: {order_price}₽")
        print(f"[BRR] 💰 Максимальная сумма для возврата: {max_price}₽")
        
        if order_price > max_price:
            print(f"[BRR] ❌ Сумма заказа {order_price}₽ > {max_price}₽ → возврат НЕ ДЕЛАЕТСЯ")
            cardinal.send_message(chat_id, f"ℹ️ Возврат не выполнен (сумма заказа {order_price}₽ превышает лимит {max_price}₽)")
            return False
        
        print(f"[BRR] ✅ Сумма заказа {order_price}₽ <= {max_price}₽ → возврат разрешен")
        
        # Проверяем возможность возврата
        if hasattr(order, 'can_refund') and not order.can_refund():
            print(f"[BRR] ❌ Возврат по заказу {order_id} НЕВОЗМОЖЕН!")
            return False
        
        # Делаем возврат
        print(f"[BRR] 💰 Выполняю возврат...")
        
        if hasattr(order, 'refund'):
            order.refund()
        else:
            cardinal.account.refund(order_id)
        
        print(f"[BRR] ✅ Возврат по заказу {order_id} ВЫПОЛНЕН!")
        
        # Отправляем сообщение покупателю
        refund_msg = SETTINGS.get("refund_message", "✅ Возврат выполнен. Извините за неудобства!")
        cardinal.send_message(chat_id, refund_msg)
        
        # Уведомление админу
        if SETTINGS.get("admin_notify", True):
            admin_msg = (
                f"💰 **Возврат выполнен!**\n\n"
                f"🆔 Заказ: {order_id}\n"
                f"⭐ Оценка: {review_stars} звезд\n"
                f"💬 Причина: {reason_text}\n"
                f"💰 Сумма: {order_price}₽\n"
                f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
            )
            admin_id = SETTINGS.get("admin_chat_id")
            if admin_id:
                cardinal.send_message(admin_id, admin_msg)
        
        return True
        
    except Exception as e:
        print(f"[BRR] ❌ ОШИБКА возврата по заказу {order_id}: {e}")
        return False

