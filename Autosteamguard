def init_plugin(c):
    global cardinal, tg, bot
    cardinal = c
    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[BRR] 💰 ЗАГРУЗКА Bad Review Refund v1.0")
    print("[BRR] 🔄 Автоматический возврат при плохих отзывах")
    print("[BRR] 🔥 Возврат ДАЖЕ при 5 звёздах (есть плохие слова)")
    print("=" * 50)
    
    load_config()
    
    c.add_telegram_commands(UUID, [("brr", "💰 Возврат по отзывам", True)])
    tg.msg_handler(show_menu, commands=["brr"])
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_toggle")
    def toggle(call):
        SETTINGS["active"] = not SETTINGS.get("active", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['active'] else 'OFF'}")
        show_menu(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_refund_toggle")
    def refund_toggle(call):
        SETTINGS["refund_enabled"] = not SETTINGS.get("refund_enabled", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['refund_enabled'] else 'OFF'}")
        show_menu(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_check_mode")
    def check_mode(call):
        SETTINGS["check_by_stars"] = not SETTINGS.get("check_by_stars", False)
        save_config()
        mode = "по звёздам" if SETTINGS["check_by_stars"] else "по тексту (звёзды НЕ важны)"
        bot.answer_callback_query(call.id, f"Режим: {mode}")
        show_menu(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_edit_text")
    def edit_text(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "💬 Введите новый текст для сообщения о возврате:")
        tg.set_state(call.message.chat.id, msg.id, call.from_user.id, "brr_edit_text")
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_show_words")
    def show_words_cb(call):
        bot.answer_callback_query(call.id)
        show_words(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_add_word")
    def add_word(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "➕ Введите слово для добавления:")
        tg.set_state(call.message.chat.id, msg.id, call.from_user.id, "brr_add_word")
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_clear_history")
    def clear_history(call):
        processed_orders.clear()
        bot.answer_callback_query(call.id, "🗑️ История очищена")
        show_menu(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_refresh")
    def refresh(call):
        bot.answer_callback_query(call.id, "🔄 Обновлено")
        show_menu(call.message)
    
    @bot.callback_query_handler(func=lambda call: call.data == "brr_menu")
    def menu(call):
        bot.answer_callback_query(call.id)
        show_menu(call.message)
    
    def handle_input(message):
        state = tg.get_state(message.chat.id, message.from_user.id)
        if not state:
            return
        
        action = state.get("action")
        
        if action == "brr_edit_text":
            SETTINGS["refund_message"] = message.text.strip()
            save_config()
            bot.reply_to(message, "✅ Текст возврата обновлён!")
            show_menu(message)
        
        elif action == "brr_add_word":
            word = message.text.strip().lower()
            if word:
                if word not in SETTINGS["bad_words"]:
                    SETTINGS["bad_words"].append(word)
                    save_config()
                    bot.reply_to(message, f"✅ Слово `{word}` добавлено!")
                else:
                    bot.reply_to(message, f"⚠️ Слово `{word}` уже есть в списке")
            show_menu(message)
        
        tg.clear_state(message.chat.id, message.from_user.id)
    
    tg.msg_handler(handle_input, func=lambda m: tg.check_state(m.chat.id, m.from_user.id))
    
    print("=" * 50)
    print("[BRR] ✅ ПЛАГИН ЗАГРУЖЕН!")
    print("[BRR] 📌 /brr — меню настроек")
    print("[BRR] 🔄 Автоматический возврат при плохих отзывах")
    print("[BRR] 🔥 Возврат ДАЖЕ при 5 звёздах")
    print("[BRR] 📋 СМОТРИ КОНСОЛЬ ДЛЯ ЛОГОВ")
    print("=" * 50)

