def show_menu(message):
    cooldown = SETTINGS.get('reply_cooldown', 86400)
    days = cooldown // 86400
    hours = (cooldown % 86400) // 3600
    
    if days > 0:
        cooldown_text = f"{days} дн"
    elif hours > 0:
        cooldown_text = f"{hours} ч"
    else:
        cooldown_text = f"{cooldown // 60} мин"
    
    work_status = "🟢 Активен" if is_work_time() else "🔴 Неактивен"
    
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton(
        f"{'🟢' if SETTINGS.get('active', True) else '🔴'} Плагин: {'ВКЛ' if SETTINGS.get('active', True) else 'ВЫКЛ'}",
        callback_data="ar_toggle"
    ))
    kb.add(InlineKeyboardButton(
        f"🌙 Период: {SETTINGS.get('work_start', '22:30')} - {SETTINGS.get('work_end', '07:59')}",
        callback_data="ar_time_settings"
    ))
    kb.add(InlineKeyboardButton(
        f"⏰ КД: {cooldown_text}",
        callback_data="ar_cooldown_settings"
    ))
    kb.add(InlineKeyboardButton(
        f"📝 Сменить текст ответа",
        callback_data="ar_edit_message"
    ))
    kb.add(InlineKeyboardButton(
        f"🔄 Обновить",
        callback_data="ar_refresh"
    ))
    
    last_reply_time = SETTINGS.get("last_reply_time", {})
    
    text = (
        f"💬 **AutoReply v{VERSION}**\n\n"
        f"📌 **Статус:** {'🟢 Активен' if SETTINGS.get('active', True) else '🔴 Отключён'}\n"
        f"🌙 **Период работы:** {work_status}\n"
        f"⏰ **Время:** {SETTINGS.get('work_start', '22:30')} - {SETTINGS.get('work_end', '07:59')}\n"
        f"⏰ **КД:** {cooldown_text}\n"
        f"💬 **Активных КД:** {len(last_reply_time)}\n\n"
        f"💬 **Текст ответа:**\n{SETTINGS.get('reply_message', '')[:100]}..."
    )
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

def show_time_settings(message):
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton(
        f"✏️ Начало: {SETTINGS.get('work_start', '22:30')}",
        callback_data="ar_time_start"
    ))
    kb.add(InlineKeyboardButton(
        f"✏️ Конец: {SETTINGS.get('work_end', '07:59')}",
        callback_data="ar_time_end"
    ))
    kb.add(InlineKeyboardButton("◀️ Назад", callback_data="ar_menu"))
    
    text = (
        f"🌙 **Настройка периода работы**\n\n"
        f"Текущее время: **{datetime.now().strftime('%H:%M')}**\n"
        f"Период активен: **{'🟢 ДА' if is_work_time() else '🔴 НЕТ'}**\n\n"
        f"Начало: **{SETTINGS.get('work_start', '22:30')}**\n"
        f"Конец: **{SETTINGS.get('work_end', '07:59')}**\n\n"
        f"В этом периоде бот будет отвечать на сообщения."
    )
    
    bot.send_message(message.chat.id, text, reply_markup=kb)

def show_cooldown_settings(message):
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton(
        f"✏️ Изменить КД",
        callback_data="ar_cooldown_value"
    ))
