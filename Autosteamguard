def load_config():
    global SETTINGS, schedule_counter
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()
    
    templates = SETTINGS.get("templates", {})
    if templates:
        max_id = max([int(k) for k in templates.keys()]) if templates else 0
        schedule_counter = max_id + 1

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def get_delay_seconds():
    delay = SETTINGS.get("reply_delay", 30)
    unit = SETTINGS.get("reply_delay_unit", "seconds")
    
    if unit == "seconds":
        return delay
    elif unit == "minutes":
        return delay * 60
    elif unit == "hours":
        return delay * 3600
    elif unit == "days":
        return delay * 86400
    else:
        return delay

def get_day_name():
    days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    return days[datetime.now().weekday()]

def get_current_time():
    return datetime.now().strftime("%H:%M")

def format_text_with_variables(text, chat_id=None, order=None, username=None):
    if not text:
        return text
    
    text = text.replace("{date}", datetime.now().strftime("%d.%m.%Y"))
    text = text.replace("{time}", datetime.now().strftime("%H:%M"))
    text = text.replace("{datetime}", datetime.now().strftime("%d.%m.%Y %H:%M:%S"))
    
    if cardinal.account:
        text = text.replace("{username}", cardinal.account.username if hasattr(cardinal.account, 'username') else "")
    
    if username:
        text = text.replace("{buyer_username}", username)
    
    if order:
        text = text.replace("{order_id}", str(order.id))
        text = text.replace("{order_price}", str(order.price))
    
    return text

def can_send_reply(chat_id):
    """Проверяет КД"""
    last_reply_time = SETTINGS.get("last_reply_time", {})
    now = time.time()
    last_reply = last_reply_time.get(str(chat_id), 0)
    cooldown = SETTINGS.get("reply_cooldown", 3600)
    
    if now - last_reply < cooldown:
        remaining = int(cooldown - (now - last_reply))
        logger.debug(f"⏸️ КД для чата {chat_id}: осталось {remaining}с")
        return False
    
    return True

def update_last_reply(chat_id):
    """Обновляет время последнего ответа"""
    last_reply_time = SETTINGS.get("last_reply_time", {})
    last_reply_time[str(chat_id)] = time.time()
    SETTINGS["last_reply_time"] = last_reply_time
    save_config()

