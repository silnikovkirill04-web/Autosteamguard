# 🔥 НАСТРОЙКИ
DEFAULT_SETTINGS = {
    "active": True,
    "auto_reply_enabled": True,
    "reply_delay": 30,
    "reply_delay_unit": "seconds",
    "reply_cooldown": 3600,
    "admin_notify": True,
    "reply_message": "Здравствуйте! Я сейчас не у экрана. Оставьте ваше сообщение, я отвечу в ближайшее время.",
    "last_reply_time": {},  # {chat_id: timestamp}
}

SETTINGS = DEFAULT_SETTINGS.copy()

# ============================================
# 🔧 СЛУЖЕБНЫЕ ФУНКЦИИ
# ============================================

def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def get_delay_seconds():
    delay = SETTINGS.get("reply_delay", 30)
    unit = SETTINGS.get("reply_delay_unit", "seconds")
    
    if unit == "seconds":
        return delay
    elif unit == "minutes":
        return delay * 60
    elif unit == "hours":
        return delay * 3600
    elif unit == "days":
        return delay * 86400
    else:
        return delay

def format_text_with_variables(text, chat_id=None, username=None):
    if not text:
        return text
    
    text = text.replace("{date}", datetime.now().strftime("%d.%m.%Y"))
    text = text.replace("{time}", datetime.now().strftime("%H:%M"))
    text = text.replace("{datetime}", datetime.now().strftime("%d.%m.%Y %H:%M:%S"))
    
    if cardinal.account:
        username_acc = cardinal.account.username if hasattr(cardinal.account, 'username') else ""
        text = text.replace("{username}", username_acc)
    
    if username:
        text = text.replace("{buyer_username}", username)
    
    return text

def can_send_reply(chat_id):
    """Проверяет КД"""
    last_reply_time = SETTINGS.get("last_reply_time", {})
    now = time.time()
    last_reply = last_reply_time.get(str(chat_id), 0)
    cooldown = SETTINGS.get("reply_cooldown", 3600)
    
    if now - last_reply < cooldown:
        remaining = int(cooldown - (now - last_reply))
        logger.debug(f"⏸️ КД для чата {chat_id}: осталось {remaining}с")
        return False
    
    return True

def update_last_reply(chat_id):
    """Обновляет время последнего ответа"""
    last_reply_time = SETTINGS.get("last_reply_time", {})
    last_reply_time[str(chat_id)] = time.time()
    SETTINGS["last_reply_time"] = last_reply_time
    save_config()

# ============================================
# 🔄 ОБРАБОТЧИК НОВЫХ СООБЩЕНИЙ (ПРАВИЛЬНЫЙ)
# ============================================

def message_handler(msg_obj):
    """
    Обрабатывает новое сообщение через хук BIND_TO_NEW_MESSAGE
    msg_obj — это объект нового сообщения из ядра Cardinal
    """
    
    if not SETTINGS.get("active", True):
        return
    
    if not SETTINGS.get("auto_reply_enabled", True):
        return
    
    try:
        # 🔥 ПРОВЕРЯЕМ, ЧТО СООБЩЕНИЕ НЕ ОТ НАС
        if getattr(msg_obj, "is_employee", False):
            return
        
        # 🔥 ПОЛУЧАЕМ CHAT_ID
        chat_id = getattr(msg_obj, "chat_id", None) or getattr(msg_obj, "node_id", None)
        if not chat_id:
            return
        
        # 🔥 ПРОВЕРЯЕМ КД
        if not can_send_reply(chat_id):
            return
        
        # 🔥 ПОЛУЧАЕМ ТЕКСТ СООБЩЕНИЯ
        msg_text = getattr(msg_obj, "text", "")
        if not msg_text:
            return
        
        # 🔥 ПОЛУЧАЕМ ИМЯ ПОКУПАТЕЛЯ
        username = None
        if hasattr(msg_obj, "author"):
            username = msg_obj.author
        elif hasattr(msg_obj, "user_name"):
            username = msg_obj.user_name
        
        # 🔥 ОТПРАВЛЯЕМ ОТВЕТ С ЗАДЕРЖКОЙ
        delay = get_delay_seconds()
        
        def send_reply():
            time.sleep(delay)
            try:
                # Проверяем КД еще раз
                if not can_send_reply(chat_id):
                    return
                
                reply_text = SETTINGS.get("reply_message", 
                    "Здравствуйте! Я сейчас не у экрана. Оставьте ваше сообщение, я отвечу в ближайшее время.")
                reply_text = format_text_with_variables(reply_text, chat_id, username)
                
                # 🔥 ПРАВИЛЬНАЯ ОТПРАВКА В ЧАТ FunPay
                # Используем account.send_message для отправки в чат FunPay
                if hasattr(cardinal.account, 'send_message'):
                    cardinal.account.send_message(chat_id, reply_text)
                elif hasattr(cardinal, 'send_order_message'):
                    cardinal.send_order_message(chat_id, reply_text)
                else:
                    # Fallback — отправляем через основной метод
                    cardinal.send_message(chat_id, reply_text)
                
                update_last_reply(chat_id)
                
                logger.info(f"📤 Отправлен автоответ в чат {chat_id} (задержка {delay}с)")
                
                if SETTINGS.get("admin_notify", True):
                    admin_id = SETTINGS.get("admin_chat_id")
                    if admin_id:
                        admin_msg = (
                            f"💬 **Автоответ отправлен!**\n\n"
                            f"🆔 Чат: {chat_id}\n"
                            f"👤 Пользователь: {username or 'Неизвестно'}\n"
                            f"💬 Сообщение: {msg_text[:50]}...\n"
                            f"⏱ Задержка: {delay}с\n"
                            f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
                        )
                        cardinal.send_message(admin_id, admin_msg)
            except Exception as e:
                logger.error(f"❌ Ошибка отправки ответа: {e}")
        
        threading.Thread(target=send_reply, daemon=True).start()
        
    except Exception as e:
        logger.error(f"❌ Ошибка обработки сообщения: {e}")

