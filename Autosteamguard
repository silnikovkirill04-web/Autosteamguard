def _handle_code_command(cardinal: Cardinal, sender: str, text: str):
    parts = text.split(maxsplit=1)
    requested_login = parts[1].strip() if len(parts) > 1 else None

    all_user_accounts = db.get_accounts_by_owner(sender)

    if not all_user_accounts:
        chat = cardinal.account.get_chat_by_name(sender, True)
        if chat:
            cardinal.send_message(chat.id, config["messages"]["no_active_rental"])
        return

    target_account = None

    if requested_login:
        for acc in all_user_accounts:
            if acc["login"].lower() == requested_login.lower():
                target_account = acc
                break
        if not target_account:
            chat = cardinal.account.get_chat_by_name(sender, True)
            if chat:
                cardinal.send_message(
                    chat.id,
                    f"❌ Аккаунт с логином {requested_login} не найден в вашей аренде.\n\n"
                    f"Ваши аккаунты:\n" +
                    "\n".join([f"• {acc['login']}" for acc in all_user_accounts]) +
                    f"\n\nИспользуйте: /code логин"
                )
            return
    else:
        if len(all_user_accounts) == 1:
            target_account = all_user_accounts[0]
        else:
            chat = cardinal.account.get_chat_by_name(sender, True)
            if chat:
                cardinal.send_message(
                    chat.id,
                    f"❓ У вас несколько аккаунтов в аренде.\n\n"
                    f"Укажите логин аккаунта:\n" +
                    "\n".join([f"• {acc['login']}" for acc in all_user_accounts]) +
                    f"\n\nПример: /code {all_user_accounts[0]['login']}"
                )
            return

    code = get_steam_guard_code(target_account["path_to_maFile"])

    chat = cardinal.account.get_chat_by_name(sender, True)
    if chat:
        if code:
            msg = config["messages"]["steam_code"].format(
                account_name=target_account["account_name"],
                code=code
            )
            cardinal.send_message(chat.id, msg)
            logger.info(f"[STEAM MSG] Отправлен код для {target_account['login']} пользователю {sender}")
        else:
            cardinal.send_message(chat.id, "❌ Ошибка генерации кода. Обратитесь в поддержку.")


