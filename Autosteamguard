# 🚀 ИНИЦИАЛИЗАЦИЯ
# ============================================

def init_plugin(c):
    global cardinal, tg, bot
    cardinal = c
    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[SAR] 💬 ЗАГРУЗКА Schedule AutoReply v2.3")
    print("[SAR] 🔄 Правильная архитектура для Cardinal")
    print("=" * 50)
    
    load_config()
    
    c.add_telegram_commands(UUID, [
        ("sar", "💬 Автоответы по расписанию", True)
    ])
    tg.msg_handler(show_menu, commands=["sar"])
    
    # Обработчики ввода
    def handle_input(message):
        state = tg.get_state(message.chat.id, message.from_user.id)
        if not state:
            return
        
        action = state.get("action")
        
        if action == "sar_edit_message":
            SETTINGS["reply_message"] = message.text.strip()
            save_config()
            bot.reply_to(message, "✅ Текст ответа обновлён!")
            show_menu(message)
        
        elif action == "sar_delay_value":
            try:
                value = int(message.text.strip())
                if value >= 0:
                    SETTINGS["reply_delay"] = value
                    save_config()
                    bot.reply_to(message, f"✅ Задержка установлена: {value} {SETTINGS.get('reply_delay_unit', 'сек')}")
                else:
                    bot.reply_to(message, "❌ Введите положительное число!")
            except ValueError:
                bot.reply_to(message, "❌ Введите число!")
            show_delay_settings(message)
        
        elif action == "sar_cooldown_value":
            try:
                value = int(message.text.strip())
                if value >= 0:
                    SETTINGS["reply_cooldown"] = value
                    save_config()
                    bot.reply_to(message, f"✅ КД установлено: {value} секунд ({value//60} мин)")
                else:
                    bot.reply_to(message, "❌ Введите положительное число!")
            except ValueError:
                bot.reply_to(message, "❌ Введите число!")
            show_cooldown_settings(message)
        
        tg.clear_state(message.chat.id, message.from_user.id)
    
    tg.msg_handler(handle_input, func=lambda m: tg.check_state(m.chat.id, m.from_user.id))
    
    # 🔥 КОЛБЭКИ
    def toggle_cb(call):
        SETTINGS["active"] = not SETTINGS.get("active", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['active'] else 'OFF'}")
        show_menu(call.message)
    
    def reply_toggle_cb(call):
        SETTINGS["auto_reply_enabled"] = not SETTINGS.get("auto_reply_enabled", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['auto_reply_enabled'] else 'OFF'}")
        show_menu(call.message)
    
    def refresh_cb(call):
        bot.answer_callback_query(call.id, "🔄 Обновлено")
        show_menu(call.message)
    
    def menu_cb(call):
        bot.answer_callback_query(call.id)
        show_menu(call.message)
    
    def edit_message_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "📝 Введите новый текст для автоответа:")
        tg.set_state(call.message.chat.id, call.from_user.id, "sar_edit_message")
    
    def delay_settings_cb(call):
        bot.answer_callback_query(call.id)
        show_delay_settings(call.message)
    
    def delay_unit_cb(call):
        unit = call.data.replace("sar_delay_unit_", "")
        SETTINGS["reply_delay_unit"] = unit
        save_config()
        bot.answer_callback_query(call.id, f"Единица: {unit}")
        show_delay_settings(call.message)
    
    def delay_value_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, f"✏️ Введите значение задержки (в {SETTINGS.get('reply_delay_unit', 'сек')}):")
        tg.set_state(call.message.chat.id, call.from_user.id, "sar_delay_value")
    
    def cooldown_settings_cb(call):
        bot.answer_callback_query(call.id)
        show_cooldown_settings(call.message)
    
    def cooldown_value_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "✏️ Введите КД в секундах (например: 3600 = 1 час):")
        tg.set_state(call.message.chat.id, call.from_user.id, "sar_cooldown_value")
    
    def cooldown_reset_cb(call):
        SETTINGS["last_reply_time"] = {}
        save_config()
        bot.answer_callback_query(call.id, "✅ КД сброшен для всех чатов!")
        show_cooldown_settings(call.message)
    
    tg.cbq_handler(toggle_cb, lambda call: call.data == "sar_toggle")
    tg.cbq_handler(reply_toggle_cb, lambda call: call.data == "sar_reply_toggle")
    tg.cbq_handler(refresh_cb, lambda call: call.data == "sar_refresh")
    tg.cbq_handler(menu_cb, lambda call: call.data == "sar_menu")
    tg.cbq_handler(edit_message_cb, lambda call: call.data == "sar_edit_message")
    tg.cbq_handler(delay_settings_cb, lambda call: call.data == "sar_delay_settings")
    tg.cbq_handler(delay_unit_cb, lambda call: call.data.startswith("sar_delay_unit_"))
    tg.cbq_handler(delay_value_cb, lambda call: call.data == "sar_delay_value")
    tg.cbq_handler(cooldown_settings_cb, lambda call: call.data == "sar_cooldown_settings")
    tg.cbq_handler(cooldown_value_cb, lambda call: call.data == "sar_cooldown_value")
    tg.cbq_handler(cooldown_reset_cb, lambda call: call.data == "sar_cooldown_reset")
    
    print("[SAR] ✅ Плагин загружен!")
    print("[SAR] 📌 /sar — меню настроек")
    print("[SAR] 🔄 Обработчик BIND_TO_NEW_MESSAGE зарегистрирован")
    print("=" * 50)

