def init_plugin(c):
    global cardinal, tg, bot
    cardinal = c
    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[AR] 💬 ЗАГРУЗКА AutoReply v2.9")
    print("[AR] 🔄 Исправлена совместимость с версиями Cardinal")
    print("=" * 50)
    
    load_config()
    
    c.add_telegram_commands(UUID, [
        ("ar", "💬 Автоответы", True)
    ])
    tg.msg_handler(show_menu, commands=["ar"])
    
    def handle_input(message):
        state = tg.get_state(message.chat.id, message.from_user.id)
        if not state:
            return
        
        action = state.get("action")
        
        if action == "ar_edit_message":
            SETTINGS["reply_message"] = message.text.strip()
            save_config()
            bot.reply_to(message, "✅ Текст ответа обновлён!")
            show_menu(message)
        
        elif action == "ar_time_start":
            time_str = message.text.strip()
            if re.match(r'^\d{2}:\d{2}$', time_str):
                SETTINGS["work_start"] = time_str
                save_config()
                bot.reply_to(message, f"✅ Начало периода: {time_str}")
            else:
                bot.reply_to(message, "❌ Неверный формат! Используйте HH:MM")
            show_time_settings(message)
        
        elif action == "ar_time_end":
            time_str = message.text.strip()
            if re.match(r'^\d{2}:\d{2}$', time_str):
                SETTINGS["work_end"] = time_str
                save_config()
                bot.reply_to(message, f"✅ Конец периода: {time_str}")
            else:
                bot.reply_to(message, "❌ Неверный формат! Используйте HH:MM")
            show_time_settings(message)
        
        elif action == "ar_cooldown_value":
            try:
                value = int(message.text.strip())
                if value >= 0:
                    SETTINGS["reply_cooldown"] = value
                    save_config()
                    days = value // 86400
                    hours = (value % 86400) // 3600
                    minutes = (value % 3600) // 60
                    bot.reply_to(message, f"✅ КД установлено: {days}д {hours}ч {minutes}мин")
                else:
                    bot.reply_to(message, "❌ Введите положительное число!")
            except ValueError:
                bot.reply_to(message, "❌ Введите число!")
            show_cooldown_settings(message)
        
        tg.clear_state(message.chat.id, message.from_user.id)
    
    tg.msg_handler(handle_input, func=lambda m: tg.check_state(m.chat.id, m.from_user.id))
    
    # 🔥 КОЛБЭКИ
    def toggle_cb(call):
        SETTINGS["active"] = not SETTINGS.get("active", True)
        save_config()
        bot.answer_callback_query(call.id, f"{'ON' if SETTINGS['active'] else 'OFF'}")
        show_menu(call.message)
    
    def refresh_cb(call):
        bot.answer_callback_query(call.id, "🔄 Обновлено")
        show_menu(call.message)
    
    def menu_cb(call):
        bot.answer_callback_query(call.id)
        show_menu(call.message)
    
    def edit_message_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "📝 Введите новый текст для автоответа:")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_edit_message")
    
    def time_settings_cb(call):
        bot.answer_callback_query(call.id)
        show_time_settings(call.message)
    
    def time_start_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "🌙 Введите время начала периода (HH:MM):")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_time_start")
    
    def time_end_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "🌙 Введите время окончания периода (HH:MM):")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_time_end")
    
    def cooldown_settings_cb(call):
        bot.answer_callback_query(call.id)
        show_cooldown_settings(call.message)
    
    def cooldown_value_cb(call):
        bot.answer_callback_query(call.id)
        msg = bot.send_message(call.message.chat.id, "✏️ Введите КД в секундах:")
        tg.set_state(call.message.chat.id, call.from_user.id, "ar_cooldown_value")
    
    def cooldown_reset_cb(call):
        SETTINGS["last_reply_time"] = {}
        save_config()
        bot.answer_callback_query(call.id, "✅ КД сброшен для всех чатов!")
        show_cooldown_settings(call.message)
    
    tg.cbq_handler(toggle_cb, lambda call: call.data == "ar_toggle")
    tg.cbq_handler(refresh_cb, lambda call: call.data == "ar_refresh")
    tg.cbq_handler(menu_cb, lambda call: call.data == "ar_menu")
    tg.cbq_handler(edit_message_cb, lambda call: call.data == "ar_edit_message")
    tg.cbq_handler(time_settings_cb, lambda call: call.data == "ar_time_settings")
    tg.cbq_handler(time_start_cb, lambda call: call.data == "ar_time_start")
    tg.cbq_handler(time_end_cb, lambda call: call.data == "ar_time_end")
    tg.cbq_handler(cooldown_settings_cb, lambda call: call.data == "ar_cooldown_settings")
    tg.cbq_handler(cooldown_value_cb, lambda call: call.data == "ar_cooldown_value")
    tg.cbq_handler(cooldown_reset_cb, lambda call: call.data == "ar_cooldown_reset")
    
    print("[AR] ✅ Плагин загружен!")
    print("[AR] 📌 /ar — меню настроек")
    print("[AR] 🌙 Период работы: 22:30 - 07:59")
    print("=" * 50)

