def load_config():
    global SETTINGS
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                for k in loaded:
                    if k in SETTINGS:
                        SETTINGS[k] = loaded[k]
        else:
            save_config()
    except Exception as e:
        logger.error(f"Ошибка загрузки конфига: {e}")
        save_config()

def save_config():
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(SETTINGS, f, indent=4, ensure_ascii=False)
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")

def check_bad_review(text):
    """Проверяет текст на наличие негативных слов"""
    if not text:
        return False
    
    text_lower = text.lower()
    
    for word in SETTINGS.get("bad_words", []):
        if word.lower() in text_lower:
            return True
        
        word_no_spaces = word.replace(" ", "")
        if word_no_spaces and word_no_spaces in text_lower.replace(" ", ""):
            return True
    
    return False

def get_order_price(order):
    """Получает сумму заказа из разных источников"""
    try:
        # Пробуем разные варианты получения цены
        if hasattr(order, 'price'):
            return float(order.price)
        elif hasattr(order, 'amount'):
            return float(order.amount)
        elif hasattr(order, 'cost'):
            return float(order.cost)
        elif hasattr(order, 'total'):
            return float(order.total)
        elif hasattr(order, 'sum'):
            return float(order.sum)
        else:
            return 0
    except:
        return 0

def get_order_id_from_review(review):
    """Получает ID заказа из отзыва разными способами"""
    try:
        if hasattr(review, 'order_id'):
            return review.order_id
        elif hasattr(review, 'order'):
            return review.order
        elif hasattr(review, 'id'):
            # Может быть ID отзыва, пробуем найти заказ по нему
            return None
        else:
            return None
    except:
        return None

def refund_order(chat_id, order_id, review_text, review_stars, reason_text):
    """Делает возврат по заказу"""
    logger.info(f"🔄 Начинаю возврат по заказу {order_id}")
    
    try:
        # Пробуем получить заказ разными способами
        order = None
        try:
            order = cardinal.account.get_order(order_id)
        except:
            pass
        
        if not order:
            # Пробуем через другой метод
            try:
                order = cardinal.account.get_order_by_id(order_id)
            except:
                pass
        
        if not order:
            logger.error(f"❌ Заказ {order_id} НЕ НАЙДЕН!")
            return False
        
        logger.info(f"✅ Заказ найден")
        
        # Проверяем сумму заказа
        order_price = get_order_price(order)
        max_price = SETTINGS.get("max_refund_price", 10)
        
        logger.info(f"💰 Сумма заказа: {order_price}₽")
        logger.info(f"💰 Максимальная сумма для возврата: {max_price}₽")
        
        if order_price > max_price:
            logger.info(f"❌ Сумма заказа {order_price}₽ > {max_price}₽ → возврат НЕ ДЕЛАЕТСЯ")
            cardinal.send_message(chat_id, f"ℹ️ Возврат не выполнен (сумма заказа {order_price}₽ превышает лимит {max_price}₽)")
            return False
        
        logger.info(f"✅ Сумма заказа {order_price}₽ <= {max_price}₽ → возврат разрешен")
        
        # Проверяем возможность возврата
        can_refund = False
        if hasattr(order, 'can_refund'):
            try:
                can_refund = order.can_refund()
            except:
                pass
        
        if not can_refund:
            logger.info(f"❌ Возврат по заказу {order_id} НЕВОЗМОЖЕН!")
            return False
        
        # Делаем возврат
        logger.info(f"💰 Выполняю возврат...")
        
        if hasattr(order, 'refund'):
            order.refund()
        elif hasattr(cardinal.account, 'refund'):
            cardinal.account.refund(order_id)
        else:
            logger.error(f"❌ Не найден метод для возврата!")
            return False
        
        logger.info(f"✅ Возврат по заказу {order_id} ВЫПОЛНЕН!")
        
        # Отправляем сообщение покупателю
        refund_msg = SETTINGS.get("refund_message", "✅ Возврат выполнен. Извините за неудобства!")
        cardinal.send_message(chat_id, refund_msg)
        
        # Уведомление админу
        if SETTINGS.get("admin_notify", True):
            admin_msg = (
                f"💰 **Возврат выполнен!**\n\n"
                f"🆔 Заказ: {order_id}\n"
                f"⭐ Оценка: {review_stars} звезд\n"
                f"💬 Причина: {reason_text}\n"
                f"💰 Сумма: {order_price}₽\n"
                f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
            )
            admin_id = SETTINGS.get("admin_chat_id")
            if admin_id:
                cardinal.send_message(admin_id, admin_msg)
        
        return True
        
    except Exception as e:
        logger.error(f"❌ ОШИБКА возврата по заказу {order_id}: {e}")
        return False

