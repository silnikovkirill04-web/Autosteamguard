def _find_cardinal_lot(cardinal: Cardinal, lot_id: str):
    try:
        if not hasattr(cardinal, 'account') or cardinal.account is None:
            return None

        lots = None

        if hasattr(cardinal.account, 'lots'):
            lots = cardinal.account.lots

        if lots is None:
            return None

        if isinstance(lots, dict):
            lot_id_int = int(lot_id) if lot_id.isdigit() else None
            if lot_id_int and lot_id_int in lots:
                return lots[lot_id_int]
            if lot_id in lots:
                return lots[lot_id]

        if isinstance(lots, list):
            for lot in lots:
                if hasattr(lot, 'id') and str(lot.id) == str(lot_id):
                    return lot

        return None
    except Exception as e:
        logger.debug(f"[STEAM LOTS] Ошибка поиска лота в Cardinal: {e}")
        return None


