    tg = c.telegram
    bot = c.telegram.bot
    
    print("=" * 50)
    print("[SAR] 💬 ЗАГРУЗКА Schedule AutoReply v2.2")
    print("[SAR] 🔄 Исправленная версия для Cardinal")
    print("=" * 50)
    
    load_config()
    
    c.add_telegram_commands(UUID, [
        ("sar", "💬 Автоответы по расписанию", True),
        ("sar_schedule", "📋 Показать шаблоны", True)
    ])
    tg.msg_handler(show_menu, commands=["sar"])
    tg.msg_handler(show_templates, commands=["sar_schedule"])
    
    # 🔥 РЕГИСТРАЦИЯ ОБРАБОТЧИКА СООБЩЕНИЙ
    def new_message_wrapper(e):
        message_handler(e)
    
    # 🔥 РЕГИСТРИРУЕМ ОБРАБОТЧИК НА НОВЫЕ СООБЩЕНИЯ
    BIND_TO_NEW_MESSAGE = [new_message_wrapper]
    
    # 🔥 ЗАПУСКАЕМ ПЛАНИРОВЩИК ДЛЯ ШАБЛОНОВ
    schedule_thread = threading.Thread(target=schedule_worker, daemon=True)
    schedule_thread.start()
    logger.info("🔄 Планировщик запущен")
    
    # Обработчики ввода
    def handle_input(message):
        state = tg.get_state(message.chat.id, message.from_user.id)
        if not state:
            return
        
        action = state.get("action")
        data = state.get("data", {})
        template_id = data.get("template_id")
        
        if action == "sar_edit_message":
            SETTINGS["reply_message"] = message.text.strip()
            save_config()
            bot.reply_to(message, "✅ Текст ответа обновлён!")
            show_menu(message)
        
        elif action == "sar_delay_value":
            try:
                value = int(message.text.strip())
                if value >= 0:
                    SETTINGS["reply_delay"] = value
                    save_config()
                    bot.reply_to(message, f"✅ Задержка установлена: {value} {SETTINGS.get('reply_delay_unit', 'сек')}")
                else:
                    bot.reply_to(message, "❌ Введите положительное число!")
            except ValueError:
                bot.reply_to(message, "❌ Введите число!")
            show_delay_settings(message)
        
        elif action == "sar_cooldown_value":
            try:
                value = int(message.text.strip())
                if value >= 0:
                    SETTINGS["reply_cooldown"] = value
                    save_config()
                    bot.reply_to(message, f"✅ КД установлено: {value} секунд ({value//60} мин)")
                else:
                    bot.reply_to(message, "❌ Введите положительное число!")
            except ValueError:
                bot.reply_to(message, "❌ Введите число!")
            show_cooldown_settings(message)
        
        elif action == "sar_add_template_name":
            name = message.text.strip()
            if name:
                templates = SETTINGS.get("templates", {})
                new_id = str(schedule_counter)
                templates[new_id] = {
                    "name": name,
                    "time": "08:00",
                    "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
                    "message": "Введите текст сообщения",
                    "active": True,
                    "last_sent": None
                }
                SETTINGS["templates"] = templates
                schedule_counter += 1
                save_config()
                bot.reply_to(message, f"✅ Шаблон '{name}' создан!")
                show_templates(message)
            else:
                bot.reply_to(message, "❌ Введите название!")
        
        elif action == "sar_template_name":
            new_name = message.text.strip()
            if new_name and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["name"] = new_name
                    save_config()
                    bot.reply_to(message, f"✅ Название обновлено!")
                show_template_edit(message, template_id)
        
        elif action == "sar_template_time":
            time_str = message.text.strip()
            if re.match(r'^\d{2}:\d{2}$', time_str) and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["time"] = time_str
                    save_config()
                    bot.reply_to(message, f"✅ Время обновлено: {time_str}")
                show_template_edit(message, template_id)
            else:
                bot.reply_to(message, "❌ Неверный формат! Используйте HH:MM")
        
        elif action == "sar_template_message":
            new_message = message.text.strip()
            if new_message and template_id:
                templates = SETTINGS.get("templates", {})
                if template_id in templates:
                    templates[template_id]["message"] = new_message
                    save_config()
                    bot.reply_to(message, f"✅ Текст обновлён!")
                show_template_edit(message, template_id)
        
        elif action == "sar_template_days":
            days_input = message.text.strip().lower()
            if template_id:
                if days_input:
                    days = [d.strip() for d in days_input.split(",")]
                    valid_days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
                    valid_input = [d for d in days if d in valid_days]
                    if valid_input:
                        templates = SETTINGS.get("templates", {})
                        if template_id in templates:
                            templates[template_id]["days"] = valid_input
                            save_config()
                            bot.reply_to(message, f"✅ Дни обновлены: {', '.join(valid_input)}")
                    else:
                        bot.reply_to(message, "❌ Введите дни на английском через запятую")
                else:
                    templates = SETTINGS.get("templates", {})
                    if template_id in templates:
                        templates[template_id]["days"] = []
                        save_config()
                        bot.reply_to(message, "✅ Дни обновлены: ежедневно")
                show_template_edit(message, template_id)
        
        tg.clear_state(message.chat.id, message.from_user.id)
    
    tg.msg_handler(handle_input, func=lambda m: tg.check_state(m.chat.id, m.from_user.id))
    
