# ============================================

def review_checker():
    """Фоновый поток, проверяющий новые отзывы через системные сообщения чатов"""
    global checker_running, stop_checker
    
    logger.info("🔄 Запущен фоновый проверщик отзывов")
    checker_running = True
    
    while True:
        try:
            # 🔥 ПРОВЕРКА ОСТАНОВКИ
            if stop_checker:
                logger.info("⏹️ Проверщик отзывов остановлен по запросу")
                break
            
            if not SETTINGS.get("active", True):
                time.sleep(5)
                continue
            
            if not SETTINGS.get("refund_enabled", True):
                time.sleep(SETTINGS.get("check_interval", 60))
                continue
            
            # 🔥 ПОЛУЧАЕМ ВСЕ ЧАТЫ
            chats = cardinal.account.get_chats(update=True)
            if not chats:
                time.sleep(SETTINGS.get("check_interval", 60))
                continue
            
            # 🔥 ПРОВЕРЯЕМ КАЖДЫЙ ЧАТ
            for chat_id, chat in chats.items():
                try:
                    # 🔥 ПОЛУЧАЕМ ID ЗАКАЗА ИЗ ЧАТА (node_id)
                    order_id = getattr(chat, 'node_id', None)
                    
                    # Если нет node_id — это не заказ
                    if not order_id:
                        continue
                    
                    # Получаем последние сообщения
                    msgs = cardinal.account.get_chat_history(chat_id, limit=5)
                    if not msgs:
                        continue
                    
                    for msg in msgs:
                        # 🔥 ПРОВЕРЯЕМ СИСТЕМНЫЕ СООБЩЕНИЯ
                        if not getattr(msg, 'is_system', False):
                            continue
                        
                        msg_text = getattr(msg, 'text', '')
                        if not msg_text or "оставил отзыв" not in msg_text:
                            continue
                        
                        logger.info(f"📝 Найдено системное сообщение: {msg_text[:100]}")
                        
                        # 🔥 ПАРСИМ ОТЗЫВ
                        stars, review_text = parse_review_from_system_message(msg_text)
                        
                        if stars is None:
                            continue
                        
                        # 🔥 ПРОВЕРЯЕМ, НЕ ОБРАБАТЫВАЛИ ЛИ УЖЕ
                        processed = SETTINGS.get("processed_orders", {})
                        if order_id in processed:
                            elapsed = time.time() - processed[order_id]
                            if elapsed < 86400:
                                continue
                        
                        # 🔥 ПОЛУЧАЕМ ЗАКАЗ ПО ID
                        try:
                            # 🔥 ИСПРАВЛЕНО: get_order_by_id
                            order = cardinal.account.get_order_by_id(order_id)
                            if not order:
                                logger.warning(f"⚠️ Заказ {order_id} не найден")
                                continue
                        except Exception as e:
                            logger.error(f"❌ Ошибка получения заказа {order_id}: {e}")
                            continue
                        
                        # 🔥 ПРОВЕРЯЕМ СУММУ ЗАКАЗА
                        order_price = get_order_price(order)
                        max_price = SETTINGS.get("max_refund_price", 10)
                        if order_price > max_price:
                            logger.info(f"💰 Сумма {order_price}₽ > {max_price}₽, пропускаем")
                            continue
                        
                        # 🔥 ОПРЕДЕЛЯЕМ, ПЛОХОЙ ЛИ ОТЗЫВ
                        is_bad = False
                        reason = ""
                        
                        if stars <= 4:
                            is_bad = True
                            reason = f"низкая оценка ({stars} звезд)"
                            logger.info(f"⭐ {stars} звезд → возврат сразу")
                        elif stars == 5 and review_text and check_bad_review(review_text):
                            is_bad = True
                            reason = "плохие слова в отзыве (5 звезд)"
                            logger.info(f"⭐ 5 звезд, но найдены плохие слова → возврат")
                        
                        if not is_bad:
                            continue
                        
                        # 🔥 ДЕЛАЕМ ВОЗВРАТ
                        logger.info(f"⚠️ Плохой отзыв по заказу {order_id}: {reason}")
                        
                        # Отправляем уведомление
                        if chat_id:
                            cardinal.send_message(chat_id, "⏳ Проверяю возможность возврата...")
                        
                        # 🔥 ИСПРАВЛЕНО: передаём ОБЪЕКТ ЗАКАЗА
                        if make_refund(order, chat_id):
                            # Отмечаем как обработанный
                            SETTINGS["processed_orders"][order_id] = time.time()
                            save_config()
                            
                            # Отправляем сообщение о возврате
                            refund_msg = SETTINGS.get("refund_message", "✅ Возврат выполнен. Извините за неудобства!")
                            if chat_id:
                                cardinal.send_message(chat_id, refund_msg)
                            
                            # Уведомление админу
                            if SETTINGS.get("admin_notify", True):
                                admin_id = SETTINGS.get("admin_chat_id")
                                if admin_id:
                                    admin_msg = (
                                        f"💰 **Возврат выполнен!**\n\n"
                                        f"🆔 Заказ: {order_id}\n"
                                        f"⭐ Оценка: {stars} звезд\n"
                                        f"💬 Причина: {reason}\n"
                                        f"📅 Время: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
                                    )
                                    cardinal.send_message(admin_id, admin_msg)
                        else:
                            if chat_id:
                                cardinal.send_message(chat_id, "❌ Не удалось выполнить возврат")
                        
                        # Не обрабатываем несколько раз одно сообщение
                        break
                        
                except Exception as e:
                    logger.error(f"❌ Ошибка обработки чата {chat_id}: {e}")
                    continue
            
            # Ждем до следующей проверки
            time.sleep(SETTINGS.get("check_interval", 60))
            
        except Exception as e:
            logger.error(f"❌ Ошибка в проверщике отзывов: {e}")
            time.sleep(30)
    
    checker_running = False
    logger.info("⏹️ Проверщик отзывов остановлен")

def start_checker():
    """Запускает проверщик в отдельном потоке"""
    global checker_thread, checker_running, stop_checker
    
    if checker_running:
        logger.info("⚠️ Проверщик уже запущен")
        return
    
    stop_checker = False
    checker_thread = threading.Thread(target=review_checker, daemon=True)
    checker_thread.start()
    logger.info("✅ Проверщик отзывов запущен")

def stop_checker_thread():
    """Останавливает проверщик"""
    global stop_checker, checker_running
    
    if not checker_running:
        return
    
    stop_checker = True
    logger.info("⏹️ Останавливаем проверщик...")
    time.sleep(2)
    checker_running = False

