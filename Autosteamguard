    def get_lots_by_game_type(self, game_type_id: int) -> List[Dict]:
        cursor = self.conn.cursor()
        cursor.execute(
            "SELECT ID, lot_name, lot_id, rental_duration FROM lots WHERE game_type_id = ?",
            (game_type_id,)
        )
        return [
            {"id": r[0], "lot_name": r[1], "lot_id": r[2], "rental_duration": r[3]}
            for r in cursor.fetchall()
        ]

    def find_game_type_by_lot_description(self, description: str) -> Optional[Dict]:
        cursor = self.conn.cursor()
        cursor.execute("""
            SELECT game_types.ID, game_types.name, lots.rental_duration, lots.lot_name
            FROM lots
            JOIN game_types ON lots.game_type_id = game_types.ID
            ORDER BY LENGTH(lots.lot_name) DESC
        """)
        results = cursor.fetchall()

        for row in results:
            game_type_id, game_type_name, rental_duration, lot_name = row
            lot_name_stripped = lot_name.strip()
            if lot_name_stripped in description:
                logger.info(f"[STEAM DB] ✅ Найдено совпадение: '{lot_name_stripped}' в описании")
                return {
                    "game_type_id": game_type_id,
                    "game_type_name": game_type_name,
                    "rental_duration": rental_duration
                }

        logger.warning(f"[STEAM DB] ❌ Лот не найден в описании: '{description}'")
        return None

